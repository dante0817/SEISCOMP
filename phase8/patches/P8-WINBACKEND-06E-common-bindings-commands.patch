diff --git a/src/system/apps/seiscomp/seiscomp-control.py b/src/system/apps/seiscomp/seiscomp-control.py
--- a/src/system/apps/seiscomp/seiscomp-control.py
+++ b/src/system/apps/seiscomp/seiscomp-control.py
@@ -436,7 +436,51 @@
     return 0
 
 
+def _windows_management(request, args):
+    if not args and request in ("enable", "disable"):
+        error("module name required")
+        return 1
+    selected = [mod for mod in mods if not args or mod.name in args]
+    if request == "status" and args == ["enabled"]:
+        selected = [mod for mod in mods if env.isModuleEnabled(mod.name) or isinstance(mod, seiscomp.kernel.CoreModule)]
+    elif request == "status" and args == ["started"]:
+        selected = [mod for mod in mods if shouldModuleRun(mod.name)]
+    elif args and set(args) - {mod.name for mod in selected}:
+        error("Unknown native module requested")
+        return 1
+    failed = 0
+    for mod in selected:
+        try:
+            if request == "status":
+                if mod.status(shouldModuleRun(mod.name)) != 0:
+                    failed += 1
+                elif shouldModuleRun(mod.name) and not mod.isRunning():
+                    failed += 1
+            elif isinstance(mod, seiscomp.kernel.CoreModule):
+                error(f"{mod.name} is a core module; enable/disable is unsupported")
+                failed += 1
+            elif request == "enable":
+                hook = getattr(mod, "enable", None)
+                if hook is not None and hook() != 0:
+                    error(f"{mod.name} failed or does not support enable")
+                    failed += 1
+                    continue
+                env.enableModule(mod.name)
+                if not env.isModuleEnabled(mod.name):
+                    failed += 1
+            else:
+                env.disableModule(mod.name)
+                if env.isModuleEnabled(mod.name):
+                    failed += 1
+        except Exception as exc:
+            error(f"Native {request} failed for {mod.name}: {exc}")
+            failed += 1
+    return 1 if failed else 0
+
+
 def on_enable(args, _):
+    if os.name == "nt":
+        return _windows_management("enable", args)
     if not args:
         error("module name required")
         return 1
