diff --git a/libs/seiscomp/client/windows_stop.h b/libs/seiscomp/client/windows_stop.h
new file mode 100644
--- /dev/null
+++ b/libs/seiscomp/client/windows_stop.h
@@ -0,0 +1,36 @@
+/* Private Windows Client-loop adapter; same AGPLv3/commercial terms as
+ * client/application.cpp. No generic System/Qt/reactor STOP support. */
+#ifndef SEISCOMP_CLIENT_WINDOWS_STOP_H
+#define SEISCOMP_CLIENT_WINDOWS_STOP_H
+#ifdef WIN32
+#include <seiscomp/client/application.h>
+#include "../system/windows_control.h"
+#include <atomic>
+#include <thread>
+
+namespace Seiscomp { namespace Client { namespace Detail {
+void optInWindowsStop(const Application *);
+void forgetWindowsStop(const Application *);
+bool windowsStopOptedIn(const Application *);
+bool isWindowsStopOwner(const Application *);
+
+// Stack lifetime is nested in the qualified run loop, before done/destruction.
+// The worker captures only this queue adapter; never Application or its state.
+class WindowsClientStop {
+public:
+	WindowsClientStop(const Application *, ThreadedQueue<Notification> &);
+	~WindowsClientStop();
+	WindowsClientStop(const WindowsClientStop &) = delete;
+	WindowsClientStop &operator=(const WindowsClientStop &) = delete;
+private:
+	void listen() noexcept;
+	ThreadedQueue<Notification> &_queue;
+	System::Detail::WindowsStopEvents _events;
+	HANDLE _cancel = nullptr;
+	std::atomic<unsigned> _ticket{0};
+	std::atomic<DWORD> _error{0};
+	std::thread _listener;
+};
+}}}
+#endif
+#endif
diff --git a/libs/seiscomp/client/windows_stop.cpp b/libs/seiscomp/client/windows_stop.cpp
new file mode 100644
--- /dev/null
+++ b/libs/seiscomp/client/windows_stop.cpp
@@ -0,0 +1,85 @@
+/* Private Windows Client-loop adapter; same AGPLv3/commercial terms as
+ * client/application.cpp. Same SID/session trust; no networking or signals. */
+#define SEISCOMP_COMPONENT Application
+#include "windows_stop.h"
+#ifdef WIN32
+#include <seiscomp/client/queue.ipp>
+#include <seiscomp/logging/log.h>
+#include <mutex>
+#include <set>
+#include <stdexcept>
+#include <system_error>
+
+namespace Seiscomp { namespace Client { namespace Detail {
+namespace {
+std::mutex RegistryMutex;
+std::set<const Application *> OptedIn;
+thread_local const Application *Owner = nullptr;
+bool CapabilityAttempted = false;
+ThreadedQueue<Notification> &claimCapability(const Application *app, ThreadedQueue<Notification> &queue) {
+	std::lock_guard<std::mutex> lock(RegistryMutex);
+	if ( !OptedIn.count(app) || CapabilityAttempted || Owner )
+		throw std::runtime_error("Windows Client STOP requires explicit opt-in and a single capability attempt per process");
+	CapabilityAttempted = true; // No name reuse/rearm even after failure or loop reentry.
+	return queue;
+}
+}
+void optInWindowsStop(const Application *app) {
+	std::lock_guard<std::mutex> lock(RegistryMutex);
+	OptedIn.insert(app);
+}
+void forgetWindowsStop(const Application *app) {
+	std::lock_guard<std::mutex> lock(RegistryMutex);
+	OptedIn.erase(app);
+}
+bool windowsStopOptedIn(const Application *app) {
+	std::lock_guard<std::mutex> lock(RegistryMutex);
+	return OptedIn.count(app) != 0;
+}
+bool isWindowsStopOwner(const Application *app) { return Owner == app; }
+
+WindowsClientStop::WindowsClientStop(const Application *app, ThreadedQueue<Notification> &queue)
+: _queue(claimCapability(app, queue)) {
+	if ( Owner ) throw std::runtime_error("A Windows STOP owner loop is already active on this thread");
+	_cancel = CreateEventW(nullptr, TRUE, FALSE, nullptr); // Unnamed, private, noninherited.
+	if ( !_cancel ) throw std::system_error(GetLastError(), std::system_category(), "STOP cancellation event");
+	try { _listener = std::thread(&WindowsClientStop::listen, this); }
+	catch ( ... ) { CloseHandle(_cancel); _cancel = nullptr; throw; }
+	Owner = app;
+}
+WindowsClientStop::~WindowsClientStop() {
+	// Cancellation wins against a pending insertion, or an already committed
+	// no-throw insertion finishes before join. No queue lock/capacity wait in worker.
+	_ticket.exchange(2);
+	SetEvent(_cancel);
+	_listener.join();
+	CloseHandle(_cancel);
+	Owner = nullptr;
+	if ( auto error = _error.load() ) SEISCOMP_ERROR("Windows STOP listener failed: %lu", error);
+}
+void WindowsClientStop::listen() noexcept {
+	HANDLE handles[] = {_cancel, _events.request()};
+	while ( _ticket.load() == 0 ) {
+		DWORD status = WaitForMultipleObjects(2, handles, FALSE, 20);
+		if ( status == WAIT_OBJECT_0 ) return;
+		if ( status == WAIT_TIMEOUT ) continue;
+		if ( status != WAIT_OBJECT_0 + 1 ) { _error = GetLastError(); return; }
+		const ULONGLONG deadline = GetTickCount64() + 5000;
+		while ( _ticket.load() == 0 && GetTickCount64() < deadline ) {
+			auto result = _queue.tryPushWindowsControl(Notification(Notification::WindowsStop), _ticket);
+			using Result = ThreadedQueue<Notification>::WindowsPushResult;
+			if ( result == Result::Queued ) {
+				if ( !SetEvent(_events.accepted()) ) _error = GetLastError();
+				return; // One-shot, duplicate requests cannot enqueue another STOP.
+			}
+			if ( result != Result::Busy ) return;
+			status = WaitForSingleObject(_cancel, 10);
+			if ( status == WAIT_OBJECT_0 ) return;
+			if ( status != WAIT_TIMEOUT ) { _error = GetLastError(); return; }
+		}
+		if ( _ticket.load() == 0 ) _error = ERROR_TIMEOUT;
+		return; // Full queue/deadline expires without acknowledgement.
+	}
+}
+}}}
+#endif
