+#ifdef WIN32
+template <typename T>
+typename ThreadedQueue<T>::WindowsPushResult
+ThreadedQueue<T>::tryPushWindowsControl(T v, std::atomic<unsigned> &ticket) {
+	static_assert(std::is_nothrow_copy_assignable<T>::value,
+	              "Windows control insertion must not throw after committing");
+	lock lk(_monitor, std::try_to_lock);
+	if ( !lk.owns_lock() ) return WindowsPushResult::Busy;
+	if ( ticket.load() != 0 ) return WindowsPushResult::Cancelled;
+	if ( _closed ) return WindowsPushResult::Closed;
+	if ( _buffered == _buffer.size() ) return WindowsPushResult::Busy;
+	unsigned pending = 0;
+	if ( !ticket.compare_exchange_strong(pending, 1) ) return WindowsPushResult::Cancelled;
+	_buffer[_end] = v;
+	_end = (_end + 1) % _buffer.size();
+	++_buffered;
+	_notEmpty.notify_all();
+	return WindowsPushResult::Queued;
+}
+#endif
