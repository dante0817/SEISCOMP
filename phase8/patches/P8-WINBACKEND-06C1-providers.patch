+/* Windows-only private control support; same AGPLv3/commercial terms as
+ * system/application.cpp. Original application and scientific code preserved. */
+#ifndef SEISCOMP_SYSTEM_WINDOWS_CONTROL_H
+#define SEISCOMP_SYSTEM_WINDOWS_CONTROL_H
+#ifdef WIN32
+#include <seiscomp/core.h>
+#include <memory>
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+namespace Seiscomp { namespace System { namespace Detail {
+// Owns a newly created pair for this process incarnation. Never adopts objects.
+// Same-user/session trust boundary; not authentication against hostile same-SID code.
+class SC_SYSTEM_CORE_API WindowsStopEvents {
+public:
+	WindowsStopEvents();
+	~WindowsStopEvents();
+	WindowsStopEvents(const WindowsStopEvents &) = delete;
+	WindowsStopEvents &operator=(const WindowsStopEvents &) = delete;
+	HANDLE request() const;
+	HANDLE accepted() const;
+private:
+	struct Impl;
+	std::unique_ptr<Impl> _impl;
+};
+}}}
+#endif
+#endif
diff --git a/libs/seiscomp/system/windows_control.cpp b/libs/seiscomp/system/windows_control.cpp
new file mode 100644
--- /dev/null
+++ b/libs/seiscomp/system/windows_control.cpp
@@ -0,0 +1,145 @@
+/* Windows-only private control support; same AGPLv3/commercial terms as
+ * system/application.cpp. No signal emulation, services or networking. */
+#include "windows_control.h"
+#ifdef WIN32
+#include <aclapi.h>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+#include <system_error>
+#include <vector>
+
+namespace Seiscomp { namespace System { namespace Detail {
+namespace {
+struct Handle {
+	HANDLE value = nullptr;
+	~Handle() { if ( value ) CloseHandle(value); }
+	Handle() = default;
+	Handle(const Handle &) = delete;
+	Handle &operator=(const Handle &) = delete;
+};
+struct LocalMemory {
+	HLOCAL value = nullptr;
+	~LocalMemory() { if ( value ) LocalFree(value); }
+};
+void require(BOOL result, const char *operation) {
+	if ( !result ) throw std::system_error(GetLastError(), std::system_category(), operation);
+}
+void check(DWORD error, const char *operation) {
+	if ( error ) throw std::system_error(error, std::system_category(), operation);
+}
+std::vector<unsigned char> tokenInfo(HANDLE token, TOKEN_INFORMATION_CLASS type) {
+	DWORD size = 0;
+	GetTokenInformation(token, type, nullptr, 0, &size);
+	if ( GetLastError() != ERROR_INSUFFICIENT_BUFFER || !size || size > 65536 )
+		throw std::runtime_error("STOP token information unavailable");
+	std::vector<unsigned char> data(size);
+	require(GetTokenInformation(token, type, data.data(), size, &size), "GetTokenInformation");
+	return data;
+}
+void verifySecurity(HANDLE event, PSID user, PSID system) {
+	PSID owner = nullptr;
+	PACL acl = nullptr;
+	PSECURITY_DESCRIPTOR sd = nullptr;
+	check(GetSecurityInfo(event, SE_KERNEL_OBJECT, OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+	                      &owner, nullptr, &acl, nullptr, &sd), "GetSecurityInfo(STOP)");
+	LocalMemory memory; memory.value = sd;
+	SECURITY_DESCRIPTOR_CONTROL control = 0;
+	DWORD revision = 0;
+	require(GetSecurityDescriptorControl(sd, &control, &revision), "GetSecurityDescriptorControl");
+	if ( !owner || !EqualSid(owner, user) || !(control & SE_DACL_PROTECTED) ||
+	     !acl || !IsValidAcl(acl) || acl->AceCount != 2 )
+		throw std::runtime_error("STOP endpoint owner/protected DACL mismatch");
+	bool foundUser = false, foundSystem = false;
+	for ( DWORD i = 0; i < 2; ++i ) {
+		void *raw = nullptr;
+		require(GetAce(acl, i, &raw), "GetAce");
+		auto *ace = static_cast<ACCESS_ALLOWED_ACE *>(raw);
+		PSID sid = &ace->SidStart;
+		if ( ace->Header.AceType != ACCESS_ALLOWED_ACE_TYPE || ace->Header.AceFlags || !IsValidSid(sid) )
+			throw std::runtime_error("STOP endpoint has an unexpected ACE");
+		if ( EqualSid(sid, user) && !foundUser &&
+		     ace->Mask == (READ_CONTROL | SYNCHRONIZE | EVENT_MODIFY_STATE) ) foundUser = true;
+		else if ( EqualSid(sid, system) && !foundSystem && ace->Mask == EVENT_ALL_ACCESS ) foundSystem = true;
+		else throw std::runtime_error("STOP endpoint grants unexpected rights");
+	}
+	if ( !foundUser || !foundSystem ) throw std::runtime_error("STOP endpoint ACL incomplete");
+}
+}
+
+struct WindowsStopEvents::Impl {
+	Handle request, accepted;
+};
+
+WindowsStopEvents::WindowsStopEvents() : _impl(new Impl) {
+	Handle threadToken;
+	if ( OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &threadToken.value) )
+		throw std::runtime_error("STOP capability refuses an impersonating thread");
+	if ( GetLastError() != ERROR_NO_TOKEN ) require(FALSE, "OpenThreadToken");
+	Handle token;
+	require(OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token.value), "OpenProcessToken");
+	auto userData = tokenInfo(token.value, TokenUser);
+	auto ownerData = tokenInfo(token.value, TokenOwner);
+	auto integrityData = tokenInfo(token.value, TokenIntegrityLevel);
+	auto sessionData = tokenInfo(token.value, TokenSessionId);
+	auto elevationData = tokenInfo(token.value, TokenElevation);
+	auto typeData = tokenInfo(token.value, TokenType);
+	PSID user = reinterpret_cast<TOKEN_USER *>(userData.data())->User.Sid;
+	PSID owner = reinterpret_cast<TOKEN_OWNER *>(ownerData.data())->Owner;
+	PSID integrity = reinterpret_cast<TOKEN_MANDATORY_LABEL *>(integrityData.data())->Label.Sid;
+	DWORD session = 0;
+	require(ProcessIdToSessionId(GetCurrentProcessId(), &session), "ProcessIdToSessionId");
+	if ( !IsValidSid(user) || !IsValidSid(owner) || !EqualSid(user, owner) ||
+	     !IsValidSid(integrity) || !*GetSidSubAuthorityCount(integrity) ||
+	     *GetSidSubAuthority(integrity, *GetSidSubAuthorityCount(integrity) - 1) != SECURITY_MANDATORY_MEDIUM_RID ||
+	     !session || session != *reinterpret_cast<DWORD *>(sessionData.data()) ||
+	     reinterpret_cast<TOKEN_ELEVATION *>(elevationData.data())->TokenIsElevated ||
+	     *reinterpret_cast<TOKEN_TYPE *>(typeData.data()) != TokenPrimary )
+		throw std::runtime_error("STOP capability requires a non-elevated medium-integrity user-owned primary token in a client session");
+	unsigned char systemStorage[SECURITY_MAX_SID_SIZE];
+	PSID system = systemStorage;
+	DWORD systemSize = sizeof(systemStorage);
+	require(CreateWellKnownSid(WinLocalSystemSid, nullptr, system, &systemSize), "CreateWellKnownSid");
+	EXPLICIT_ACCESSW entries[2] = {};
+	entries[0].grfAccessPermissions = READ_CONTROL | SYNCHRONIZE | EVENT_MODIFY_STATE;
+	entries[1].grfAccessPermissions = EVENT_ALL_ACCESS;
+	for ( unsigned i = 0; i < 2; ++i ) {
+		entries[i].grfAccessMode = SET_ACCESS;
+		entries[i].grfInheritance = NO_INHERITANCE;
+		entries[i].Trustee.TrusteeForm = TRUSTEE_IS_SID;
+		entries[i].Trustee.TrusteeType = TRUSTEE_IS_USER;
+		entries[i].Trustee.ptstrName = reinterpret_cast<LPWSTR>(i ? system : user);
+	}
+	PACL acl = nullptr;
+	check(SetEntriesInAclW(2, entries, nullptr, &acl), "SetEntriesInAclW");
+	LocalMemory aclMemory; aclMemory.value = acl;
+	SECURITY_DESCRIPTOR sd;
+	require(InitializeSecurityDescriptor(&sd, SECURITY_DESCRIPTOR_REVISION), "InitializeSecurityDescriptor");
+	require(SetSecurityDescriptorOwner(&sd, user, FALSE), "SetSecurityDescriptorOwner");
+	require(SetSecurityDescriptorDacl(&sd, TRUE, acl, FALSE), "SetSecurityDescriptorDacl");
+	require(SetSecurityDescriptorControl(&sd, SE_DACL_PROTECTED, SE_DACL_PROTECTED), "SetSecurityDescriptorControl");
+	SECURITY_ATTRIBUTES attributes = {sizeof(attributes), &sd, FALSE};
+	FILETIME created, ended, kernel, cpu;
+	require(GetProcessTimes(GetCurrentProcess(), &created, &ended, &kernel, &cpu), "GetProcessTimes");
+	const auto time = (static_cast<unsigned long long>(created.dwHighDateTime) << 32) | created.dwLowDateTime;
+	std::wostringstream prefix;
+	prefix << L"Local\\SeisComP.Control." << GetCurrentProcessId() << L'.'
+	       << std::hex << std::nouppercase << std::setfill(L'0') << std::setw(16) << time;
+	auto create = [&](Handle &destination, const wchar_t *suffix) {
+		const auto name = prefix.str() + suffix;
+		SetLastError(ERROR_SUCCESS);
+		destination.value = CreateEventExW(&attributes, name.c_str(), CREATE_EVENT_MANUAL_RESET,
+		                                  READ_CONTROL | SYNCHRONIZE | EVENT_MODIFY_STATE);
+		const DWORD error = GetLastError(); // Capture before any other API call.
+		if ( !destination.value || error == ERROR_ALREADY_EXISTS )
+			throw std::system_error(error, std::system_category(), "New STOP endpoint creation (collision is refused)");
+		verifySecurity(destination.value, user, system);
+	};
+	create(_impl->request, L".StopRequest");
+	create(_impl->accepted, L".StopAccepted");
+}
+WindowsStopEvents::~WindowsStopEvents() = default;
+HANDLE WindowsStopEvents::request() const { return _impl->request.value; }
+HANDLE WindowsStopEvents::accepted() const { return _impl->accepted.value; }
+}}}
+#endif
