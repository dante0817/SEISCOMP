+typedef char ew_trace2_header_size[(sizeof(TRACE2_HEADER)==64)?1:-1];
+typedef char ew_trace_starttime_offset[(offsetof(TRACE_HEADER,starttime)==8)?1:-1];
+typedef char ew_trace_sample_rate_offset[(offsetof(TRACE_HEADER,samprate)==24)?1:-1];
+typedef char ew_logo_size[(sizeof(MSG_LOGO)==3)?1:-1];
