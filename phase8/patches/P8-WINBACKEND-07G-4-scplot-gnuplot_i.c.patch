+#ifdef WIN32
+/* Retain original template/lifetime; random suffix plus atomic exclusive create. */
+static int gp_mkstemp(char *name) {
+    static const char alphabet[] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+    size_t length = strlen(name);
+    int attempt, index, fd;
+    if (length < 6) { errno = EINVAL; return -1; }
+    for (attempt = 0; attempt < 128; ++attempt) {
+        for (index = 0; index < 6; ++index) {
+            unsigned int random;
+            if (rand_s(&random)) { errno = EIO; return -1; }
+            name[length - 6 + index] = alphabet[random % 62];
+        }
+        errno_t error = _sopen_s(&fd, name, _O_CREAT | _O_EXCL | _O_RDWR | _O_BINARY | _O_NOINHERIT,
+                                _SH_DENYNO, _S_IREAD | _S_IWRITE);
+        if (!error) return fd;
+        if (error != EEXIST) { errno = error; return -1; }
+    }
+    errno = EEXIST; return -1;
+}
+#define mkstemp gp_mkstemp
 #endif
 
