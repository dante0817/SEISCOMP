+inline int fs_native_open(const char *path,int flags){return _open(path,flags|_O_BINARY|_O_NOINHERIT);}
+#define open fs_native_open
+#define read _read
+#define close _close
+#define lseek _lseek
+#define unlink _unlink
+#define mkdir(path,mode) _mkdir(path)
+#define stat _stat64
+#define fstat _fstat64
+#define STDOUT_FILENO 1
+#define write _write
+#ifndef S_ISDIR
+#define S_ISDIR(mode) (((mode)&_S_IFMT)==_S_IFDIR)
+#define S_ISREG(mode) (((mode)&_S_IFMT)==_S_IFREG)
+#endif
+#endif
