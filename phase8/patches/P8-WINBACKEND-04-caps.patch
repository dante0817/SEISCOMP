 namespace {
+#ifdef _WIN32
+bool native_socket_ready(SOCKET fd,bool writing,int seconds=0,int micros=0){
+ ULONGLONG duration=seconds>0 || micros>0?ULONGLONG(seconds)*1000+(micros+999)/1000:ULLONG_MAX;
+ ULONGLONG start=GetTickCount64();
+ for(;;){
+  if(duration!=ULLONG_MAX && GetTickCount64()-start>=duration){errno=ETIMEDOUT;return false;}
+  if(sl_native_plugin_stop_requested()>0){errno=EINTR;return false;}
+  WSAPOLLFD p{fd,short(writing?POLLWRNORM:POLLRDNORM),0};
+  int interval=200;if(duration!=ULLONG_MAX){ULONGLONG elapsed=GetTickCount64()-start;if(elapsed>=duration){errno=ETIMEDOUT;return false;}interval=int(std::min<ULONGLONG>(200,duration-elapsed));}
+  int n=WSAPoll(&p,1,interval);if(n>0){if(p.revents&POLLNVAL){errno=EBADF;return false;}return true;}
+  if(n==SOCKET_ERROR){errno=EIO;return false;}
+ }
+}
+struct NativeBioSocket {SOCKET value;int seconds,micros;};
+int native_bio_read(BIO *bio,char *buffer,int count){
+ BIO_clear_retry_flags(bio);auto p=static_cast<NativeBioSocket*>(BIO_get_data(bio));if(!p || !native_socket_ready(p->value,false,p->seconds,p->micros))return -1;
+ int n=recv(p->value,buffer,count,0);if(n==SOCKET_ERROR){int e=WSAGetLastError();if(e==WSAEWOULDBLOCK || e==WSAEINTR)BIO_set_retry_read(bio);return -1;}return n;
+}
+int native_bio_write(BIO *bio,const char *buffer,int count){
+ BIO_clear_retry_flags(bio);auto p=static_cast<NativeBioSocket*>(BIO_get_data(bio));if(!p || !native_socket_ready(p->value,true,p->seconds,p->micros))return -1;
+ int n=send(p->value,buffer,count,0);if(n==SOCKET_ERROR){int e=WSAGetLastError();if(e==WSAEWOULDBLOCK || e==WSAEINTR)BIO_set_retry_write(bio);return -1;}return n;
+}
+long native_bio_ctrl(BIO*,int command,long,void*){return command==BIO_CTRL_FLUSH?1:0;}
+int native_bio_create(BIO *bio){BIO_set_init(bio,1);BIO_set_data(bio,nullptr);return 1;}
+int native_bio_destroy(BIO *bio){delete static_cast<NativeBioSocket*>(BIO_get_data(bio));BIO_set_data(bio,nullptr);return 1;}
+BIO *native_socket_bio(SOCKET socket,int seconds,int micros){
+ static BIO_METHOD *method=[](){BIO_METHOD *m=BIO_meth_new(BIO_get_new_index()|BIO_TYPE_SOURCE_SINK,"native CAPS SOCKET");if(!m)return static_cast<BIO_METHOD*>(nullptr);BIO_meth_set_read(m,native_bio_read);BIO_meth_set_write(m,native_bio_write);BIO_meth_set_ctrl(m,native_bio_ctrl);BIO_meth_set_create(m,native_bio_create);BIO_meth_set_destroy(m,native_bio_destroy);return m;}();
+ if(!method)return nullptr;BIO *bio=BIO_new(method);if(bio)BIO_set_data(bio,new NativeBioSocket{socket,seconds,micros});return bio;
+}
