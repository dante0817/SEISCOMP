--- a/src/base/contrib-sed/libs/swig/CMakeLists.txt
+++ b/src/base/contrib-sed/libs/swig/CMakeLists.txt
@@ -1,3 +1,19 @@
+IF(WIN32 AND SC_WINDOWS_CONTROLLER_ONLY)
+ # Original strong-motion wrapper has no NumPy API; retain the configured ABI.
+ ADD_LIBRARY(_strongmotion MODULE strongmotionPYTHON_wrap.cxx)
+ TARGET_INCLUDE_DIRECTORIES(_strongmotion PRIVATE "${PYTHON_INCLUDE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_SOURCE_DIR}/src/system/libs/swig")
+ TARGET_COMPILE_OPTIONS(_strongmotion PRIVATE "/FI${SC_WINDOWS_PYTHON_GUARD}")
+ TARGET_LINK_LIBRARIES(_strongmotion PRIVATE Python::Python seiscomp_datamodel_sm seiscomp_core)
+ SET_TARGET_PROPERTIES(_strongmotion PROPERTIES PREFIX "" SUFFIX ".pyd"
+  LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib/python/$<CONFIG>/seiscomp/datamodel"
+  RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib/python/$<CONFIG>/seiscomp/datamodel"
+  ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib/$<CONFIG>/python")
+ INSTALL(TARGETS _strongmotion LIBRARY DESTINATION lib/python/seiscomp/datamodel COMPONENT WindowsController
+  RUNTIME DESTINATION lib/python/seiscomp/datamodel COMPONENT WindowsController)
+ INSTALL(FILES strongmotion.py DESTINATION lib/python/seiscomp/datamodel COMPONENT WindowsController)
+ RETURN()
+ENDIF()
+
 FIND_PACKAGE(Numpy)
 
 INCLUDE_DIRECTORIES(${PYTHON_INCLUDE_DIR})
