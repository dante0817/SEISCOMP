 	bool fdValid = fcntl(socket->fd(), F_GETFD) != -1 || errno != EBADF;
+	#endif
 	if ( !fdValid )
-		SEISCOMP_ERROR("Invalid fd = %d", socket->fd());
+		SEISCOMP_ERROR("Invalid socket handle = %llu",
+		               static_cast<unsigned long long>(socket->fd()));
 
 	return fdValid;
 }
