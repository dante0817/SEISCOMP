+
+int Device::_deviceCount = 0;
+
+Device::Device() : _fd(INVALID_SOCKET) {
+	++_deviceCount;
+	_selectMode = Idle;
+	_group = nullptr;
+	_qPrev = _qNext = nullptr;
+	_timeout = -1;
+}
+
+Device::Device(handle_type fd) : _fd(fd) {
+	++_deviceCount;
+	_selectMode = Idle;
+	_group = nullptr;
+	_qPrev = _qNext = nullptr;
+	_timeout = -1;
+}
+
+Device::~Device() {
+	--_deviceCount;
+}
+
+bool Device::isValid() const {
+	return _fd != INVALID_SOCKET;
+}
+
+void Device::setMode(int mode) {
+	if ( _selectMode == mode ) return;
+	_selectMode = mode;
+	if ( _group ) _group->updateState(this);
+}
+
+void Device::addMode(int mode) {
+	setMode(_selectMode | mode);
+}
+
+void Device::removeMode(int mode) {
+	setMode(_selectMode & ~mode);
+}
+
+bool Device::setTimeout(int milliseconds) {
+	if ( _timeout == milliseconds ) return true;
+	_timeout = milliseconds;
+	if ( _group ) _group->applyTimeout(this);
+	return true;
+}
+
+Device::Status Device::setNonBlocking(bool nonBlocking) {
+	if ( !isValid() ) return InvalidDevice;
+	u_long mode = nonBlocking ? 1 : 0;
+	return ioctlsocket(_fd, FIONBIO, &mode) == 0 ? Success : Error;
+}
+
+Device::handle_type Device::takeFd() {
+	handle_type handle = _fd;
+	_fd = INVALID_SOCKET;
+	return handle;
+}
+
+Device::handle_type Device::fd() const {
+	return _fd;
+}
+
+DeviceGroup::DeviceGroup()
+: _triggerMode(LevelTriggered), _readyForRead(false), _readyForWrite(false),
+  _timedOut(false), _isInSelect(false), _isInterrupted(false),
+  _timerSeconds(0), _timerMilliseconds(0), _timerSingleShot(false),
+  _fnTimeout(), _timerFd(-1), _interrupt_read_fd(INVALID_SOCKET),
+  _interrupt_write_fd(INVALID_SOCKET), _wsaInitialized(false),
+  _timerActive(false), _timerDeadline(), _timerInterval(0),
+  _lastCallDuration(0), _queue(nullptr), _nextQueue(nullptr) {
+	_selectIndex = _selectSize = _count = 0;
+}
+
+DeviceGroup::~DeviceGroup() {
+	clear();
+}
+
+bool DeviceGroup::isValid() const {
+	return _interrupt_read_fd != INVALID_SOCKET && _interrupt_write_fd != INVALID_SOCKET;
+}
+
+bool DeviceGroup::setup() {
+	if ( isValid() ) {
+		SEISCOMP_ERROR("[reactor] already set up");
+		return false;
+	}
+
+	WSADATA data;
+	int result = WSAStartup(MAKEWORD(2, 2), &data);
+	if ( result != 0 ) {
+		SEISCOMP_ERROR("WSAStartup failed: %d", result);
+		return false;
+	}
+	_wsaInitialized = true;
+
+	_interrupt_read_fd = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+	_interrupt_write_fd = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+	if ( !isValid() ) {
+		SEISCOMP_ERROR("Unable to create reactor wakeup sockets: %d", WSAGetLastError());
+		clear();
+		return false;
+	}
+
+	sockaddr_in address{};
+	address.sin_family = AF_INET;
+	address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+	address.sin_port = 0;
+	if ( ::bind(_interrupt_read_fd, reinterpret_cast<const sockaddr*>(&address), sizeof(address)) == SOCKET_ERROR ) {
+		SEISCOMP_ERROR("Unable to bind reactor wakeup socket: %d", WSAGetLastError());
+		clear();
+		return false;
+	}
+
+	int addressLength = sizeof(address);
+	if ( getsockname(_interrupt_read_fd, reinterpret_cast<sockaddr*>(&address), &addressLength) == SOCKET_ERROR ||
+	     ::connect(_interrupt_write_fd, reinterpret_cast<const sockaddr*>(&address), sizeof(address)) == SOCKET_ERROR ) {
+		SEISCOMP_ERROR("Unable to connect reactor wakeup sockets: %d", WSAGetLastError());
+		clear();
+		return false;
+	}
+
+	u_long nonBlocking = 1;
+	if ( ioctlsocket(_interrupt_read_fd, FIONBIO, &nonBlocking) == SOCKET_ERROR ||
+	     ioctlsocket(_interrupt_write_fd, FIONBIO, &nonBlocking) == SOCKET_ERROR ) {
+		SEISCOMP_ERROR("Unable to configure reactor wakeup sockets: %d", WSAGetLastError());
+		clear();
+		return false;
+	}
+
+	return true;
+}
+
+bool DeviceGroup::append(Device *device) {
+	if ( !device || device->_group ) {
+		SEISCOMP_WARNING("Device is null or already part of a group");
+		return false;
+	}
+	if ( !device->isValid() ) return false;
+	int socketType = 0;
+	int socketTypeSize = sizeof(socketType);
+	if ( getsockopt(device->fd(), SOL_SOCKET, SO_TYPE,
+	                reinterpret_cast<char*>(&socketType), &socketTypeSize) == SOCKET_ERROR ) {
+		SEISCOMP_ERROR("WSAPoll supports socket devices only (handle %llu, Winsock error %d)",
+		               static_cast<unsigned long long>(device->fd()), WSAGetLastError());
+		return false;
+	}
+	if ( !isValid() && !setup() ) return false;
+	device->_group = this;
+	_devices.push_back({WSAPOLLFD{device->fd(), 0, 0}, device});
+	++_count;
+	if ( device->_timeout >= 0 ) applyTimeout(device);
+	return true;
+}
+
+bool DeviceGroup::remove(Device *device) {
+	if ( !device || device->_group != this ) {
+		SEISCOMP_WARNING("Device is not part of that group");
+		return false;
+	}
+	device->_group = nullptr;
+	if ( _isInSelect ) interrupt();
+	if ( _nextQueue == device ) _nextQueue = device->_qNext;
+	if ( device->_qPrev || device->_qNext || _queue == device ) removeFromQueue(device);
+	_devices.erase(std::remove_if(_devices.begin(), _devices.end(),
+		[device](const PollEvent &entry) { return entry.device == device; }), _devices.end());
+	for ( size_t i = 0; i < _selectIndex && i < _pollEvents.size(); ++i )
+		if ( _pollEvents[i].device == device ) --_selectIndex;
+	_pollEvents.erase(std::remove_if(_pollEvents.begin(), _pollEvents.end(),
+		[device](const PollEvent &entry) { return entry.device == device; }), _pollEvents.end());
+	--_count;
+	_selectSize = _pollEvents.size();
+	return true;
+}
+
+size_t DeviceGroup::count() const {
+	return _count;
+}
+
+void DeviceGroup::clear() {
+	for ( auto &entry : _devices ) {
+		if ( entry.device && entry.device->_group == this ) entry.device->_group = nullptr;
+	}
+	_devices.clear();
+	_pollEvents.clear();
+	_count = _selectIndex = _selectSize = 0;
+	_queue = _nextQueue = nullptr;
+	_timerActive = false;
+	_fnTimeout = TimeoutFunc();
+	if ( _interrupt_write_fd != INVALID_SOCKET ) {
+		closesocket(_interrupt_write_fd);
+		_interrupt_write_fd = INVALID_SOCKET;
+	}
+	if ( _interrupt_read_fd != INVALID_SOCKET ) {
+		closesocket(_interrupt_read_fd);
+		_interrupt_read_fd = INVALID_SOCKET;
+	}
+	if ( _wsaInitialized ) {
+		WSACleanup();
+		_wsaInitialized = false;
+	}
+}
+
+bool DeviceGroup::setTimer(uint32_t seconds, uint32_t milliseconds, TimeoutFunc func) {
+	if ( !func ) {
+		SEISCOMP_ERROR("Failed to create timer: function required");
+		return false;
+	}
+	if ( !isValid() && !setup() ) return false;
+	_timerSeconds = seconds;
+	_timerMilliseconds = milliseconds;
+	_timerInterval = std::chrono::milliseconds(
+		static_cast<uint64_t>(seconds) * 1000 + milliseconds);
+	_fnTimeout = std::move(func);
+	if ( _timerInterval.count() == 0 ) {
+		_timerActive = false;
+		return true;
+	}
+	_timerDeadline = std::chrono::steady_clock::now() + _timerInterval;
+	_timerActive = true;
+	return true;
+}
+
+bool DeviceGroup::clearTimer() {
+	if ( !_timerActive ) return false;
+	_timerActive = false;
+	_fnTimeout = TimeoutFunc();
+	return true;
+}
+
+void DeviceGroup::interrupt() {
+	if ( _interrupt_write_fd == INVALID_SOCKET ) return;
+	const char byte = 1;
+	int result = ::send(_interrupt_write_fd, &byte, 1, 0);
+	if ( result == SOCKET_ERROR && WSAGetLastError() != WSAEWOULDBLOCK )
+		SEISCOMP_ERROR("[reactor] interrupt send failed: %d", WSAGetLastError());
+}
+
+Device *DeviceGroup::wait() {
+	_isInterrupted = false;
+	_readyForRead = _readyForWrite = _timedOut = false;
+	_selectIndex = _selectSize = 0;
+	if ( !isValid() && !setup() ) return nullptr;
+
+	std::vector<WSAPOLLFD> pollFds;
+	std::vector<Device*> pollDevices;
+	pollFds.reserve(_devices.size() + 1);
+	pollDevices.reserve(_devices.size() + 1);
+	pollFds.push_back(WSAPOLLFD{_interrupt_read_fd, POLLRDNORM, 0});
+	pollDevices.push_back(nullptr);
+	for ( const auto &entry : _devices ) {
+		if ( !entry.device || !entry.device->isValid() ) continue;
+		short events = 0;
+		if ( entry.device->selectMode() & Device::Read ) events |= POLLRDNORM;
+		if ( entry.device->selectMode() & Device::Write ) events |= POLLWRNORM;
+		if ( events ) {
+			pollFds.push_back(WSAPOLLFD{entry.device->fd(), events, 0});
+			pollDevices.push_back(entry.device);
+		}
+	}
+
+	int timeout = -1;
+	if ( _queue ) timeout = std::max(0, _queue->_ticker);
+	if ( _timerActive ) {
+		auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
+			_timerDeadline - std::chrono::steady_clock::now()).count();
+		int timerTimeout = static_cast<int>(std::max<int64_t>(0, std::min<int64_t>(remaining, INT_MAX)));
+		if ( timeout < 0 || timerTimeout < timeout ) timeout = timerTimeout;
+	}
+
+	auto started = std::chrono::steady_clock::now();
+	_isInSelect = true;
+	int result = WSAPoll(pollFds.data(), static_cast<ULONG>(pollFds.size()), timeout);
+	_isInSelect = false;
+	auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+		std::chrono::steady_clock::now() - started).count();
+	_lastCallDuration = static_cast<int>(std::min<int64_t>(elapsed, INT_MAX));
+	if ( result == SOCKET_ERROR ) {
+		if ( WSAGetLastError() != WSAEINTR )
+			SEISCOMP_ERROR("[reactor] WSAPoll failed: %d", WSAGetLastError());
+		return nullptr;
+	}
+
+	_pollEvents.clear();
+	for ( size_t i = 0; i < pollFds.size(); ++i ) {
+		if ( !pollFds[i].revents ) continue;
+		Device *device = pollDevices[i];
+		if ( device && std::none_of(_devices.begin(), _devices.end(),
+			[device](const PollEvent &entry) { return entry.device == device; }) )
+			continue;
+		_pollEvents.push_back({pollFds[i], device});
+	}
+	_selectSize = _pollEvents.size();
+	_nextQueue = _queue;
+	return next();
+}
+
+Device *DeviceGroup::next() {
+	while ( _nextQueue ) {
+		_nextQueue->_ticker -= _lastCallDuration;
+		if ( _nextQueue->_ticker <= 0 ) {
+			Device *device = _nextQueue;
+			_nextQueue = _nextQueue->_qNext;
+			bool hasTrigger = std::any_of(_pollEvents.begin() + static_cast<std::ptrdiff_t>(_selectIndex),
+				_pollEvents.end(), [device](const PollEvent &entry) { return entry.device == device; });
+			removeFromQueue(device);
+			if ( !hasTrigger ) {
+				_readyForRead = _readyForWrite = false;
+				_timedOut = true;
+				return device;
+			}
+		}
+		else _nextQueue = _nextQueue->_qNext;
+	}
+
+	_timedOut = false;
+	if ( _timerActive && std::chrono::steady_clock::now() >= _timerDeadline ) {
+		TimeoutFunc callback = _fnTimeout;
+		_timerDeadline = std::chrono::steady_clock::now() + _timerInterval;
+		if ( callback ) callback();
+	}
+
+	while ( _selectIndex < _selectSize ) {
+		const PollEvent &event = _pollEvents[_selectIndex++];
+		if ( !event.device ) {
+			char bytes[128];
+			while ( ::recv(_interrupt_read_fd, bytes, sizeof(bytes), 0) > 0 ) {}
+			_isInterrupted = true;
+			continue;
+		}
+
+		Device *device = event.device;
+		if ( device->_timeout >= 0 ) applyTimeout(device);
+		_readyForRead = (event.pollfd.revents & (POLLRDNORM | POLLIN)) != 0;
+		_readyForWrite = (event.pollfd.revents & (POLLWRNORM | POLLOUT)) != 0;
+		if ( !_readyForRead && (event.pollfd.revents & (POLLERR | POLLHUP | POLLNVAL)) )
+			device->close();
+		return device;
+	}
+
+	_selectIndex = _selectSize = 0;
+	return nullptr;
+}
+
+bool DeviceGroup::setTriggerMode(TriggerMode mode) {
+	if ( mode == EdgeTriggered ) return false;
+	_triggerMode = mode;
+	return true;
+}
+
+DeviceGroup::TriggerMode DeviceGroup::triggerMode() const {
+	return _triggerMode;
+}
+
+void DeviceGroup::removeFromQueue(Device *device) {
+	if ( device->_qPrev ) device->_qPrev->_qNext = device->_qNext;
+	else _queue = device->_qNext;
+	if ( device->_qNext ) device->_qNext->_qPrev = device->_qPrev;
+	device->_qPrev = device->_qNext = nullptr;
+}
+
+void DeviceGroup::applyTimeout(Device *device) {
+	device->_ticker = device->_timeout;
+	if ( _queue && (device->_qNext || device->_qPrev || _queue == device) ) {
+		if ( device->_timeout < 0 ) {
+			removeFromQueue(device);
+			return;
+		}
+		if ( device->_qPrev && device->_qPrev->_ticker > device->_ticker ) {
+			Device *position = device->_qPrev;
+			while ( position->_qPrev && position->_qPrev->_ticker > device->_ticker )
+				position = position->_qPrev;
+			removeFromQueue(device);
+			device->_qPrev = position->_qPrev;
+			device->_qNext = position;
+			if ( device->_qPrev ) device->_qPrev->_qNext = device;
+			else _queue = device;
+			position->_qPrev = device;
+		}
+		else if ( device->_qNext && device->_ticker > device->_qNext->_ticker ) {
+			Device *position = device->_qNext;
+			while ( position->_qNext && device->_ticker > position->_qNext->_ticker )
+				position = position->_qNext;
+			removeFromQueue(device);
+			device->_qPrev = position;
+			device->_qNext = position->_qNext;
+			if ( device->_qNext ) device->_qNext->_qPrev = device;
+			position->_qNext = device;
+		}
+	}
+	else if ( device->_timeout >= 0 ) {
+		device->_qPrev = device->_qNext = nullptr;
+		if ( !_queue ) _queue = device;
+		else {
+			Device *position = _queue;
+			Device *last = nullptr;
+			while ( position && position->_ticker <= device->_ticker ) {
+				last = position;
+				position = position->_qNext;
+			}
+			device->_qNext = position;
+			device->_qPrev = position ? position->_qPrev : last;
+			if ( device->_qPrev ) device->_qPrev->_qNext = device;
+			else _queue = device;
+			if ( position ) position->_qPrev = device;
+		}
+	}
+}
+
+void DeviceGroup::updateState(Device *) {
+	// WSAPoll registrations are rebuilt from the current device modes per wait.
+	if ( _isInSelect ) interrupt();
+}
+
+}
+}
