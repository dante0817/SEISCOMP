--- a/libs/3rd-party/tau/libtau/emdlv.c
+++ b/libs/3rd-party/tau/libtau/emdlv.c
@@ -3,6 +3,39 @@
 #include <string.h>
 #include <math.h>
 
+#ifdef _WIN32
+/* MSVC's C runtime does not provide POSIX getline. Keep the same dynamically
+ * sized, newline-preserving behavior for the velocity-model input file. */
+static int seiscomp_getline(char **line, size_t *capacity, FILE *fp) {
+	size_t length = 0;
+	int ch;
+
+	if ( *line == NULL || *capacity == 0 ) {
+		*capacity = 128;
+		*line = (char *)malloc(*capacity);
+		if ( *line == NULL ) return -1;
+	}
+
+	while ( (ch = fgetc(fp)) != EOF ) {
+		if ( length + 1 >= *capacity ) {
+			size_t next_capacity = *capacity * 2;
+			char *next_line = (char *)realloc(*line, next_capacity);
+			if ( next_line == NULL ) return -1;
+			*line = next_line;
+			*capacity = next_capacity;
+		}
+
+		(*line)[length++] = (char)ch;
+		if ( ch == '\n' ) break;
+	}
+
+	if ( length == 0 && ch == EOF ) return -1;
+	(*line)[length] = '\0';
+	return (int)length;
+}
+#define getline seiscomp_getline
+#endif
