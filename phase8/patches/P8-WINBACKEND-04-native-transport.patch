@@ -0,0 +1,21 @@
+// Windows short-option parsing for native utility entry points. Linux uses libc.
+#pragma once
+#include <cstring>
+#include <cstdio>
+static char *optarg=nullptr;
+static int optind=1;
+static int sl_option_offset=1;
+static int getopt(int argc,char **argv,const char *options){
+ if(optind>=argc)return EOF;
+ char *arg=argv[optind];if(arg[0]!='-' || !arg[1])return EOF;
+ if(!strcmp(arg,"--")){++optind;return EOF;}
+ int c=arg[sl_option_offset++];const char *spec=strchr(options,c);
+ if(!spec){if(!arg[sl_option_offset]){++optind;sl_option_offset=1;}return '?';}
+ if(spec[1]==':'){
+  if(arg[sl_option_offset])optarg=arg+sl_option_offset;
+  else if(optind+1<argc)optarg=argv[++optind];
+  else{++optind;sl_option_offset=1;return '?';}
+  ++optind;sl_option_offset=1;
+ }else if(!arg[sl_option_offset]){++optind;sl_option_offset=1;}
+ return c;
+}
