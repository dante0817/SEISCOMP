+"""Native Windows bootstrap for the unchanged controller dispatch/ownership code.
+
+SeisComP Public License, as for seiscomp-control.py. This file is not a service.
+"""
+import os
+from pathlib import Path
+import runpy
+import struct
+import sys
+
+
+def main():
+    if os.name != 'nt' or sys.version_info[:3] != (3, 10, 11) or struct.calcsize('P') != 8:
+        raise RuntimeError('Native controller requires the configured CPython 3.10.11 x64 runtime')
+    root = Path(__file__).resolve().parent.parent
+    package = root / 'lib' / 'python'
+    controller = root / 'bin' / 'seiscomp-control.py'
+    if not (package / 'seiscomp' / '_config.pyd').is_file() or not controller.is_file():
+        raise RuntimeError('Native controller staging is incomplete: controller/_config.pyd missing')
+    # Before any SeisComP import. Retain handles through runpy and interpreter cleanup.
+    dll_directories = [os.add_dll_directory(str(root / folder)) for folder in ('bin', 'lib')]
+    sys.path.insert(0, str(package))
+    os.environ['SEISCOMP_ROOT'] = str(root)
+    os.environ['SEISCOMP_WRAP'] = 'TRUE'
+    os.environ['PATH'] = os.pathsep.join([str(root / p) for p in ('bin', 'sbin', 'lib')] +
+                                         [os.environ.get('PATH', '')])
+    os.environ['PYTHONPATH'] = os.pathsep.join([str(package), os.environ.get('PYTHONPATH', '')])
+    # No host-specific Unix shell file is sourced on Windows.
+    sys.argv[0] = str(controller)
+    try:
+        runpy.run_path(str(controller), run_name='__main__')
+    finally:
+        for directory in dll_directories:
+            directory.close()
+
+
+if __name__ == '__main__':
+    main()
