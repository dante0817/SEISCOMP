diff --git a/cmake/WindowsPython310.cmake b/cmake/WindowsPython310.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/WindowsPython310.cmake
@@ -0,0 +1,73 @@
+# Windows-only bridge from the selected modern FindPython result to legacy users.
+# Identity and compile/link checks do not import or execute SeisComP code.
+IF(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
+	MESSAGE(FATAL_ERROR "Native controller requires Windows MSVC x64")
+ENDIF()
+IF(CMAKE_VERSION VERSION_LESS 3.19)
+	MESSAGE(FATAL_ERROR "Windows Python ABI verification requires CMake >= 3.19")
+ENDIF()
+FIND_PACKAGE(Python 3.10.11 EXACT REQUIRED COMPONENTS Interpreter Development)
+LIST(LENGTH Python_INCLUDE_DIRS _sc_py_include_count)
+LIST(LENGTH Python_LIBRARIES _sc_py_library_count)
+IF(NOT _sc_py_include_count EQUAL 1 OR NOT _sc_py_library_count EQUAL 1)
+	MESSAGE(FATAL_ERROR "Windows Python requires one unambiguous Release header root and import library")
+ENDIF()
+SET(_sc_py_include "${Python_INCLUDE_DIRS}")
+SET(_sc_py_library "${Python_LIBRARIES}")
+SET(SC_WINDOWS_PYTHON_IDENTITY "${CMAKE_BINARY_DIR}/WindowsPython310-identity.json")
+EXECUTE_PROCESS(
+	COMMAND "${Python_EXECUTABLE}" -I "${CMAKE_SOURCE_DIR}/cmake/windows_python_identity.py"
+		"${_sc_py_include}" "${_sc_py_library}" "${SC_WINDOWS_PYTHON_IDENTITY}"
+	RESULT_VARIABLE _sc_py_result OUTPUT_VARIABLE _sc_py_stdout ERROR_VARIABLE _sc_py_stderr)
+FILE(WRITE "${CMAKE_BINARY_DIR}/WindowsPython310-identity.log" "${_sc_py_stdout}${_sc_py_stderr}")
+IF(NOT _sc_py_result EQUAL 0)
+	MESSAGE(FATAL_ERROR "Windows Python identity failed: ${_sc_py_stdout}${_sc_py_stderr}")
+ENDIF()
+FILE(READ "${SC_WINDOWS_PYTHON_IDENTITY}" _sc_py_json)
+STRING(JSON SC_WINDOWS_PYTHON_HOME GET "${_sc_py_json}" home)
+STRING(JSON SC_WINDOWS_PYTHON_RUNTIME GET "${_sc_py_json}" runtime)
+STRING(JSON SC_WINDOWS_PYTHON_EXT_SUFFIX GET "${_sc_py_json}" ext_suffix)
+EXECUTE_PROCESS(COMMAND "${CMAKE_LINKER}" /dump /headers "${_sc_py_library}"
+	RESULT_VARIABLE _sc_lib_result OUTPUT_VARIABLE _sc_lib_dump ERROR_VARIABLE _sc_lib_error)
+FILE(WRITE "${CMAKE_BINARY_DIR}/WindowsPython310-import-library.log" "${_sc_lib_dump}${_sc_lib_error}")
+STRING(TOLOWER "${_sc_lib_dump}" _sc_lib_lower)
+STRING(REGEX MATCHALL "python[0-9_]+\\.dll" _sc_imported_dlls "${_sc_lib_lower}")
+LIST(REMOVE_DUPLICATES _sc_imported_dlls)
+IF(NOT _sc_lib_result EQUAL 0 OR NOT _sc_lib_lower MATCHES "8664 machine" OR
+	_sc_lib_lower MATCHES "14c machine|aa64 machine" OR NOT _sc_imported_dlls STREQUAL "python310.dll")
+	MESSAGE(FATAL_ERROR "Python import library must be AMD64 COFF for python310.dll; see WindowsPython310-import-library.log")
+ENDIF()
+
+# All legacy names actually consumed by system/common wrapper CMake are aligned.
+SET(PYTHON_EXECUTABLE "${Python_EXECUTABLE}" CACHE FILEPATH "Selected native Python interpreter" FORCE)
+SET(PYTHON_INCLUDE_DIR "${_sc_py_include}" CACHE PATH "Selected native Python headers" FORCE)
+SET(PYTHON_INCLUDE_PATH "${_sc_py_include}")
+SET(PYTHON_INCLUDE_DIRS "${_sc_py_include}")
+SET(PYTHON_LIBRARY "${_sc_py_library}" CACHE FILEPATH "Selected native Python Release import library" FORCE)
+SET(PYTHON_LIBRARY_RELEASE "${_sc_py_library}" CACHE FILEPATH "Selected native Python Release import library" FORCE)
+SET(PYTHON_LIBRARIES "${_sc_py_library}")
+SET(PYTHON_LIBRARY_DEBUG "PYTHON_LIBRARY_DEBUG-NOTFOUND" CACHE FILEPATH "Debug ABI is not qualified" FORCE)
+SET(PYTHON_DEBUG_LIBRARY "PYTHON_DEBUG_LIBRARY-NOTFOUND" CACHE FILEPATH "Debug ABI is not qualified" FORCE)
+SET(PYTHON_VERSION_STRING "3.10.11")
+SET(PYTHONLIBS_VERSION_STRING "3.10.11")
+SET(PYTHON_VERSION_MAJOR 3)
+SET(PYTHON_VERSION_MINOR 10)
+SET(PYTHON_VERSION_PATCH 11)
+
+SET(SC_WINDOWS_PYTHON_GUARD "${CMAKE_BINARY_DIR}/WindowsPython310-guard.h")
+FILE(WRITE "${SC_WINDOWS_PYTHON_GUARD}" "#include <Python.h>\n#if !defined(_WIN64) || !defined(MS_WIN64) || defined(_DEBUG) || PY_VERSION_HEX != 0x030A0BF0\n#error Windows controller requires CPython 3.10.11 x64 Release headers and CRT\n#endif\nstatic_assert(sizeof(void*) == 8, \"Python ABI must be x64\");\n")
+FILE(WRITE "${CMAKE_BINARY_DIR}/CMakeFiles/windows-python310-abi.cpp"
+	"#include \"${SC_WINDOWS_PYTHON_GUARD}\"\nint main() { return Py_GetVersion() == nullptr; }\n")
+FUNCTION(_sc_verify_python_link)
+	SET(CMAKE_TRY_COMPILE_CONFIGURATION Release)
+	TRY_COMPILE(_sc_abi_link "${CMAKE_BINARY_DIR}/CMakeFiles/windows-python310-link"
+		"${CMAKE_BINARY_DIR}/CMakeFiles/windows-python310-abi.cpp"
+		CMAKE_FLAGS "-DINCLUDE_DIRECTORIES=${_sc_py_include}"
+		LINK_LIBRARIES Python::Python OUTPUT_VARIABLE _sc_abi_log)
+	FILE(WRITE "${CMAKE_BINARY_DIR}/WindowsPython310-abi-link.log" "${_sc_abi_log}")
+	IF(NOT _sc_abi_link)
+		MESSAGE(FATAL_ERROR "CPython 3.10.11 x64 Release compile/link qualification failed; see WindowsPython310-abi-link.log")
+	ENDIF()
+ENDFUNCTION()
+_sc_verify_python_link()
+MESSAGE(STATUS "Windows Python ABI: CPython 3.10.11 x64 Release; legacy headers/library aligned; compile/link only")
diff --git a/cmake/windows_python_identity.py b/cmake/windows_python_identity.py
new file mode 100644
--- /dev/null
+++ b/cmake/windows_python_identity.py
@@ -0,0 +1,37 @@
+"""Configure-time CPython identity check. Standard library only; no SeisComP imports."""
+import json
+from pathlib import Path
+import re
+import struct
+import sys
+import sysconfig
+import hashlib
+
+include, library, output = map(Path, sys.argv[1:])
+if (sys.implementation.name != 'cpython' or sys.version_info[:3] != (3, 10, 11) or
+        struct.calcsize('P') != 8 or sysconfig.get_config_var('Py_DEBUG') or
+        sys.prefix != sys.base_prefix):
+    raise SystemExit('Windows controller requires the established non-debug CPython 3.10.11 x64 installation')
+version = re.search(r'^#define\s+PY_VERSION\s+"([^"]+)"',
+                    (include / 'patchlevel.h').read_text(), re.M)
+if not version or version[1] != '3.10.11' or library.name.lower() != 'python310.lib':
+    raise SystemExit('Python header/import-library version differs from selected interpreter')
+home = Path(sys.base_prefix).resolve()
+runtime = home / 'python310.dll'
+def pe(path):
+    data = path.read_bytes()
+    offset = struct.unpack_from('<I', data, 0x3c)[0]
+    if (data[offset:offset+4] != b'PE\0\0' or struct.unpack_from('<H', data, offset+4)[0] != 0x8664 or
+            struct.unpack_from('<H', data, offset+24)[0] != 0x20b):
+        raise SystemExit('Python executable/runtime must be AMD64 PE32+: ' + str(path))
+for p in [Path(sys.executable), runtime]:
+    pe(p)
+files = [Path(sys.executable), runtime, library, include / 'Python.h', include / 'patchlevel.h', include / 'pyconfig.h']
+record = dict(executable=Path(sys.executable).resolve().as_posix(), version='3.10.11',
+              version_text=sys.version, bits=64, debug=False, home=home.as_posix(),
+              include=include.resolve().as_posix(), library=library.resolve().as_posix(),
+              runtime=runtime.as_posix(), ext_suffix=sysconfig.get_config_var('EXT_SUFFIX'),
+              hashes={p.resolve().as_posix(): hashlib.sha256(p.read_bytes()).hexdigest().upper() for p in files},
+              scope='Interpreter identity and file inspection only; no SeisComP/controller/extension execution')
+output.write_text(json.dumps(record, indent=2)+'\n', encoding='utf-8')
+print('CPython 3.10.11 x64 Release identity verified; no SeisComP imported')
