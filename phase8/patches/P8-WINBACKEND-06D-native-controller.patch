diff --git a/src/system/apps/seiscomp/windows/frontend.cpp b/src/system/apps/seiscomp/windows/frontend.cpp
new file mode 100644
--- /dev/null
+++ b/src/system/apps/seiscomp/windows/frontend.cpp
@@ -0,0 +1,88 @@
+/* Native Windows frontend for the original Python controller.
+ * Same SeisComP Public License terms as seiscomp-control.py/kernel.py.
+ * Hosts the configured original CPython runtime; no shell/process-control shim. */
+#include <Python.h>
+#include <windows.h>
+#include <filesystem>
+#include <vector>
+#include <string>
+#include <cstdio>
+#include <cstring>
+#include "controller_python_config.h"
+
+namespace {
+void checked(PyStatus status) {
+	if ( PyStatus_Exception(status) ) Py_ExitStatusException(status);
+}
+class DllDirectories {
+public:
+	~DllDirectories() { for ( auto cookie : cookies ) RemoveDllDirectory(cookie); }
+	bool add(const std::filesystem::path &path) {
+		auto cookie = AddDllDirectory(path.c_str());
+		if ( !cookie ) return false;
+		cookies.push_back(cookie);
+		return true;
+	}
+private:
+	std::vector<DLL_DIRECTORY_COOKIE> cookies;
+};
+}
+
+int wmain(int argc, wchar_t **argv) {
+	// Python DLL itself is copied from the configured interpreter beside this
+	// executable. Its version and all imports are recorded during staging.
+	if ( std::strncmp(Py_GetVersion(), "3.10.11 ", 8) ) {
+		std::fputs("Configured CPython 3.10.11 runtime mismatch\n", stderr);
+		return 2;
+	}
+	std::vector<wchar_t> filename(32768);
+	DWORD size = GetModuleFileNameW(nullptr, filename.data(), static_cast<DWORD>(filename.size()));
+	if ( !size || size >= filename.size() ) {
+		std::fputs("Cannot resolve native controller installation path\n", stderr);
+		return 2;
+	}
+	const std::filesystem::path bin = std::filesystem::path(filename.data()).parent_path();
+	if ( bin.filename() != L"bin" ) {
+		std::fputs("Use the isolated installed bin layout; build-tree frontend is not an installation\n", stderr);
+		return 2;
+	}
+	const auto root = bin.parent_path();
+	DllDirectories directories;
+	if ( !SetDefaultDllDirectories(LOAD_LIBRARY_SEARCH_DEFAULT_DIRS) ||
+	     !directories.add(bin) || !directories.add(root / L"lib") ||
+	     !directories.add(std::filesystem::path(ControllerPythonHome) / L"DLLs") ) {
+		std::fprintf(stderr, "Native Python DLL search setup failed: Windows error %lu\n", GetLastError());
+		return 2;
+	}
+	// CWD is deliberately retained. Original Environment.chroot/chback owns it.
+	PyConfig config;
+	PyConfig_InitIsolatedConfig(&config);
+	checked(PyConfig_SetString(&config, &config.program_name, ControllerPythonProgram));
+	checked(PyConfig_SetString(&config, &config.executable, ControllerPythonProgram));
+	checked(PyConfig_SetString(&config, &config.base_executable, ControllerPythonProgram));
+	checked(PyConfig_SetString(&config, &config.home, ControllerPythonHome));
+	const auto packagePath = (root / L"lib" / L"python").wstring();
+	checked(PyConfig_SetString(&config, &config.pythonpath_env, packagePath.c_str()));
+	config.write_bytecode = 0;
+	config.install_signal_handlers = 1;
+	std::vector<std::wstring> arguments;
+#if SC_CONTROLLER_FRONTEND
+	config.parse_argv = 0; // Controller flags remain controller flags.
+	const auto bootstrap = (bin / L"seiscomp-bootstrap.py").wstring();
+	checked(PyConfig_SetString(&config, &config.run_filename, bootstrap.c_str()));
+	arguments.push_back(bootstrap);
+#else
+	config.parse_argv = 1; // Native replacement for the configured seiscomp-python shell wrapper.
+	arguments.emplace_back(ControllerPythonProgram);
+#endif
+	for ( int i = 1; i < argc; ++i ) arguments.emplace_back(argv[i]);
+	std::vector<wchar_t *> pointers;
+	for ( auto &argument : arguments ) pointers.push_back(argument.data());
+	checked(PyConfig_SetArgv(&config, static_cast<Py_ssize_t>(pointers.size()), pointers.data()));
+	checked(Py_InitializeFromConfig(&config));
+	PyConfig_Clear(&config);
+	const int code = Py_RunMain();
+	// Preserve the signed C-int representation of all 32 process-exit bits,
+	// matching the existing windows.run_wait convention.
+	ExitProcess(static_cast<DWORD>(code));
+}
