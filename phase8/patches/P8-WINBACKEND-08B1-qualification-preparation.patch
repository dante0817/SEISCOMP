+    command = "$ErrorActionPreference='Stop'; @{uuid=(Get-CimInstance Win32_ComputerSystemProduct).UUID; adapters=@(Get-NetAdapter -IncludeHidden | Where-Object {$_.Status -eq 'Up'} | Select-Object Name,InterfaceDescription); disks=@(Get-CimInstance Win32_LogicalDisk | Select-Object DeviceID,DriveType,FileSystem)} | ConvertTo-Json -Depth 6 -Compress"
+    powershell = Path(os.environ['SystemRoot'])/'System32/WindowsPowerShell/v1.0/powershell.exe'
+    return json.loads(subprocess.check_output([str(powershell),'-NoProfile','-NonInteractive','-Command',command], text=True, timeout=30))
+
+def admit(bundle, receipt_path, receipt_sha, approval):
+    bundle = Path(bundle).resolve(); receipt_path = Path(receipt_path).resolve()
+    if digest(receipt_path) != receipt_sha:
+        raise RuntimeError('Receipt hash mismatch')
+    receipt = json.loads(receipt_path.read_text(encoding='utf-8-sig'))
+    required = ['disposable_vm', 'network_disconnected_verified', 'no_host_shares_or_profile',
+                'filesystem_acl_verified', 'guest_os_vc_exports_verified', 'writable_work_verified',
+                'separate_operator_execution_approval']
+    if receipt.get('status') != 'ADMITTED' or any(receipt.get(k) is not True for k in required):
+        raise RuntimeError('Boundary has not been admitted')
+    if not approval or approval != receipt.get('approval_id'):
+        raise RuntimeError('Separate operator approval ID missing or differs')
+    if str(bundle) != receipt.get('guest_bundle_root'):
+        raise RuntimeError('Wrong guest payload location')
+    actual = facts()
+    if actual['uuid'] == receipt['prohibited_host_uuid'] or actual['uuid'] != receipt['guest_uuid']:
+        raise RuntimeError('Wrong computer; the development host is prohibited')
+    if actual['adapters']:
+        raise RuntimeError('Guest reports an active network adapter')
+    if any(int(d['DriveType']) == 4 for d in actual['disks']):
+        raise RuntimeError('Mapped/network drive visible in guest')
+    if not any(d['DeviceID'].lower() == bundle.drive.lower() and int(d['DriveType']) == 3 and d['FileSystem'] == 'NTFS' for d in actual['disks']):
+        raise RuntimeError('Payload is not on a fixed NTFS guest volume')
+    # Operator-supplied actual host/guest inspection and ACL evidence must remain present/hash-identical.
+    if not receipt.get('isolation_evidence') or not receipt.get('os_module_hashes'):
