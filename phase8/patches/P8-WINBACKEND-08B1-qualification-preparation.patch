+"""Source-only runtime evidence helpers. No SeisComP imports here."""
+import ctypes
+from ctypes import wintypes as W
+import hashlib
+import json
+from pathlib import Path
+import time
+
+def digest(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest().upper()
+
+def emit(kind, **value):
+    print(json.dumps(dict(kind=kind, monotonic=time.monotonic(), **value), sort_keys=True), flush=True)
+
+def loaded_modules(process_handle=None):
+    """Enumerate actual module handles; fail if the snapshot is incomplete."""
+    k = ctypes.WinDLL('kernel32', use_last_error=True)
+    p = ctypes.WinDLL('psapi', use_last_error=True)
+    k.GetCurrentProcess.restype = W.HANDLE
+    p.EnumProcessModulesEx.argtypes = [W.HANDLE, ctypes.POINTER(W.HMODULE), W.DWORD, ctypes.POINTER(W.DWORD), W.DWORD]
+    p.GetModuleFileNameExW.argtypes = [W.HANDLE, W.HMODULE, W.LPWSTR, W.DWORD]
+    handle = process_handle if process_handle is not None else k.GetCurrentProcess()
+    modules = (W.HMODULE * 4096)(); needed = W.DWORD()
+    if not p.EnumProcessModulesEx(handle, modules, ctypes.sizeof(modules), ctypes.byref(needed), 3):
+        raise ctypes.WinError(ctypes.get_last_error())
+    if needed.value > ctypes.sizeof(modules):
+        raise RuntimeError('Module snapshot exceeds capacity')
+    result = []
+    for module in modules[:needed.value // ctypes.sizeof(W.HMODULE)]:
+        path = ctypes.create_unicode_buffer(32768)
+        n = p.GetModuleFileNameExW(handle, module, path, len(path))
+        if not n or n >= len(path)-1:
+            raise ctypes.WinError(ctypes.get_last_error())
+        file = Path(path.value).resolve()
+        result.append(dict(path=str(file), sha256=digest(file)))
+    return sorted(result, key=lambda row: row['path'].lower())
+
+def verify_files(root, expected_manifest, allowed_extra=()):
+    root = Path(root).resolve(); manifest = root/'SHA256SUMS.json'
+    if digest(manifest) != expected_manifest:
+        raise RuntimeError('Manifest identity differs: '+str(root))
+    files = json.loads(manifest.read_text(encoding='utf-8'))
+    actual = {p.relative_to(root).as_posix() for p in root.rglob('*') if p.is_file() and p != manifest}
+    if not set(files).issubset(actual) or actual-set(files)-set(allowed_extra):
+        raise RuntimeError('Unexpected or missing deployment files: '+str(actual.symmetric_difference(files)))
+    for rel, expected in files.items():
+        file = (root/rel).resolve()
+        if not file.is_relative_to(root) or digest(file) != expected:
+            raise RuntimeError('File identity differs: '+rel)
+    return files
+
+def verify_loaded(rows, bundle, external):
+    """Every observed image must match a pinned payload or admitted guest OS file."""
+    expected = dict(external)
+    for sub in ['unified-native','database-native','python-home']:
+        root = bundle/sub
+        for rel, h in json.loads((root/'SHA256SUMS.json').read_text()).items():
+            expected[str((root/rel).resolve()).lower()] = h
+    for row in rows:
+        if expected.get(str(Path(row['path']).resolve()).lower()) != row['sha256']:
+            raise RuntimeError('Unadmitted loaded module: '+row['path'])
