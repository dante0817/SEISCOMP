+                   policy='one exact owned child; job limit1; close/timeout terminates this job only')
+    (out/'command.json').write_text(json.dumps(command,indent=2)+'\n')
+    process = None; snapshots=[]; observed={}; observation_errors=[]; failure=None; timed_out=False
