+        allowed = ['work/qualification.sqlite'+s for s in ['', '-journal', '-wal', '-shm']] if sub == 'database-native' else []
+        verify_files(bundle/sub, plan['manifests'][sub], allowed)
+    for rel, h in receipt['probe_hashes'].items():
