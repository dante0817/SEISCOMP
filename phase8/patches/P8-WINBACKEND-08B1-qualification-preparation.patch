+    for rel, h in receipt['isolation_evidence'].items():
+        p = (bundle/rel).resolve()
+        if not p.is_relative_to(bundle) or digest(p) != h:
+            raise RuntimeError('Isolation evidence missing or differs: '+rel)
+    plan = json.loads((bundle/'probes/deployment-plan.json').read_text())
+    if receipt.get('deployment_plan_sha256') != digest(bundle/'probes/deployment-plan.json'):
+        raise RuntimeError('Receipt does not admit this deployment plan')
