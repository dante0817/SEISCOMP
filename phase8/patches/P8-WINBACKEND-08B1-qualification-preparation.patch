+        raise RuntimeError('Receipt does not pin all runtime probe sources')
+    for path, h in receipt['os_module_hashes'].items():
+        if digest(path) != h:
+            raise RuntimeError('Guest runtime identity differs: '+path)
+    return receipt, plan, actual
