+/* Scanner-local Windows integration. Included after original private types. */
+#include <inttypes.h>
+#include <limits.h>
+typedef char ms_time_width[(sizeof(time_t)==8 && (time_t)-1<0)?1:-1];
+static HANDLE ms_wake;
+static SRWLOCK ms_control_lock=SRWLOCK_INIT;
+static volatile LONG ms_stop_requested,ms_print_requested;
+static BOOL WINAPI ms_console(DWORD event) {
+    AcquireSRWLockShared(&ms_control_lock);
+    if(!ms_wake){ReleaseSRWLockShared(&ms_control_lock);return FALSE;}
+    if(event==CTRL_C_EVENT)InterlockedExchange(&ms_stop_requested,1);
+    else if(event==CTRL_BREAK_EVENT)InterlockedExchange(&ms_print_requested,1);
+    else {ReleaseSRWLockShared(&ms_control_lock);return FALSE;} /* No fabricated HUP/TERM/service/global protocol. */
+    SetEvent(ms_wake);ReleaseSRWLockShared(&ms_control_lock);return TRUE;
+}
+static int ms_controls_init(void) {
+    if(!GetConsoleCP()) {
+        fprintf(stderr,"Windows scanner requires an attached console for stop/print notifications; non-console control is not implemented\n");
+        return -1;
+    }
+    ms_wake=CreateEventW(NULL,TRUE,FALSE,NULL);
+    if(!ms_wake || !SetConsoleCtrlHandler(ms_console,TRUE)) {
+        if(ms_wake)CloseHandle(ms_wake);return -1;
+    }
+    return 0;
+}
+static void ms_controls_poll(void) {
+    ResetEvent(ms_wake);
+    if(InterlockedExchange(&ms_stop_requested,0))stopsig=1;
+    if(InterlockedExchange(&ms_print_requested,0))print_handler(0);
+}
+static void ms_controls_close(void) {
+    SetConsoleCtrlHandler(ms_console,FALSE);
+    AcquireSRWLockExclusive(&ms_control_lock);CloseHandle(ms_wake);ms_wake=NULL;ReleaseSRWLockExclusive(&ms_control_lock);
+    if(fnmatch){ms_regfree(fnmatch);free(fnmatch);fnmatch=NULL;}
+    if(fnreject){ms_regfree(fnreject);free(fnreject);fnreject=NULL;}
+}
+static wchar_t *ms_wide(const char *text) {
+    int n;wchar_t *p;
+    n=MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,text,-1,NULL,0);
+    if(!n)return NULL;
+    p=malloc((size_t)n*sizeof(wchar_t));if(!p)return NULL;
+    if(!MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,text,-1,p,n)){free(p);return NULL;}return p;
+}
+static char *ms_utf8(const wchar_t *text) {
+    int n=WideCharToMultiByte(CP_UTF8,WC_ERR_INVALID_CHARS,text,-1,NULL,0,NULL,NULL);char *p;
+    if(!n)return NULL;p=malloc(n);if(!p)return NULL;
+    if(!WideCharToMultiByte(CP_UTF8,WC_ERR_INVALID_CHARS,text,-1,p,n,NULL,NULL)){free(p);return NULL;}return p;
+}
+static FILE *ms_native_fopen(const char *path,const char *mode) {
+    wchar_t *p=ms_wide(path),*m=ms_wide(mode);FILE *f=NULL;
+    if(p&&m)f=_wfopen(p,m);else errno=EILSEQ;free(p);free(m);return f;
+}
+static int ms_native_stat(const char *path,struct _stat64 *st) {
+    wchar_t *p=ms_wide(path);int code;if(!p){errno=EILSEQ;return -1;}
+    code=_wstat64(p,st);free(p);return code;
+}
+#ifndef S_ISDIR
+#define S_ISDIR(mode) (((mode)&_S_IFMT)==_S_IFDIR)
+#endif
+#ifndef S_ISREG
+#define S_ISREG(mode) (((mode)&_S_IFMT)==_S_IFREG)
+#endif
+static off_t ms_process_open(char*,FileNode*,off_t,time_t,HANDLE);
+static int ms_scan_walk(const wchar_t *root,const char *display,int level,int depth,time_t now,
+                       const ms_win_identity *parents,size_t count) {
+    HANDLE directory;ms_win_identity id;ms_win_identity *chain;ms_win_directory entries;
+    size_t i;int step,status=0;wchar_t *path;char *leaf,*name;FileNode *node;FileKey *key;
+    directory=ms_win_open_target(root);
+    if(directory==INVALID_HANDLE_VALUE)return -1;
+    if(ms_win_file_identity(directory,&id)<0){CloseHandle(directory);return -1;}
+    CloseHandle(directory);
+    for(i=0;i<count;++i)if(!ms_win_identity_compare(&id,&parents[i])) {
+        lprintf(0,"Directory reparse cycle: %s",display);return -1;
+    }
+    if(count>=SIZE_MAX/sizeof(id)-1)return -1;
+    chain=malloc((count+1)*sizeof(id));if(!chain)return -1;
+    if(count)memcpy(chain,parents,count*sizeof(id));chain[count]=id;
+    step=ms_win_directory_open(root,&entries);if(step<0){free(chain);return -1;}
+    while(step>0) {
+        HANDLE file;BY_HANDLE_FILE_INFORMATION info;LARGE_INTEGER size;ms_win_identity fileid;
+        int64_t modified;size_t length;
+        ms_controls_poll();if(stopsig)break;
+        if(!wcscmp(entries.current.cFileName,L".") || !wcscmp(entries.current.cFileName,L".."))goto next;
+        path=ms_win_child_path(root,entries.current.cFileName);leaf=ms_utf8(entries.current.cFileName);
+        if(!path || !leaf){free(path);free(leaf);status=-1;break;}
+        length=strlen(display)+strlen(leaf)+2;
+        if(length<strlen(display)){free(path);free(leaf);status=-1;break;}
+        name=malloc(length);if(!name){free(path);free(leaf);status=-1;break;}
+        snprintf(name,length,"%s/%s",display,leaf);
+        /* One open target provides identity, size/time, and record data. */
+        file=CreateFileW(path,GENERIC_READ,FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,NULL,
+                         OPEN_EXISTING,FILE_FLAG_BACKUP_SEMANTICS,NULL);
+        if(file==INVALID_HANDLE_VALUE) {
+            DWORD error=GetLastError();
+            if(error!=ERROR_FILE_NOT_FOUND && error!=ERROR_PATH_NOT_FOUND){lprintf(0,"Cannot open %s (%lu)",name,error);status=-1;}
+            free(path);free(leaf);free(name);if(status)break;goto next;
+        }
+        if(ms_win_file_identity(file,&fileid)<0 || !GetFileInformationByHandle(file,&info)) {
+            lprintf(0,"Unsupported file identity: %s (%lu)",name,GetLastError());status=-1;goto release;
+        }
+        if(info.dwFileAttributes&FILE_ATTRIBUTE_DIRECTORY) {
+            if(depth<level && ms_scan_walk(path,name,level,depth+1,now,chain,count+1)<0)status=-1;
+            goto release;
+        }
+        if(GetFileType(file)!=FILE_TYPE_DISK){lprintf(0,"Not a regular disk file: %s",name);goto release;}
+        if(fnmatch || fnreject) {
+            int yes=fnmatch?regexec(fnmatch,leaf,0,NULL,0):0;
+            int no=fnreject?regexec(fnreject,leaf,0,NULL,0):1;
+            if(yes>1 || no>1){lprintf(0,"Unsupported regex filename/evaluation: %s",name);status=-1;goto release;}
+            if(yes || !no)goto release;
+        }
+        if(!GetFileSizeEx(file,&size) || size.QuadPart<0){status=-1;goto release;}
+        { ULARGE_INTEGER ticks;ticks.LowPart=info.ftLastWriteTime.dwLowDateTime;ticks.HighPart=info.ftLastWriteTime.dwHighDateTime;
+          if(ticks.QuadPart<116444736000000000ULL)modified=-(int64_t)((116444736000000000ULL-ticks.QuadPart+9999999ULL)/10000000ULL);
+          else modified=(int64_t)((ticks.QuadPart-116444736000000000ULL)/10000000ULL); }
+        if(strlen(name)>SIZE_MAX-sizeof(FileKey)){status=-1;goto release;}
+        key=malloc(sizeof(FileKey)+strlen(name));if(!key){status=-1;goto release;}
+        key->inode=fileid;strcpy(key->filename,name);node=findfile(key);free(key);
+        if(node) {
+            if(node->offset==-1){node->scantime=now;goto release;}
+            if(node->idledelay>0){node->scantime=now;--node->idledelay;goto release;}
+            if(node->quiet)goto release;
+        }
+        if(!node) {
+            node=addfile(fileid,name,(time_t)modified);
+            if(!node){status=-1;goto release;}
+            node->offset=nextnew?size.QuadPart:ms_process_open(name,node,size.QuadPart,(time_t)modified,file);
+        }
+        else if(node->modtime<modified && node->offset<size.QuadPart)
+            node->offset=ms_process_open(name,node,size.QuadPart,(time_t)modified,file);
+        if(node->idledelay==0 && modified<(now-idlesec))node->idledelay=idledelay>0?idledelay-1:0;
+        if(quietsec && modified<(now-quietsec))node->quiet=1;
+        node->scantime=now;
+release:
+        CloseHandle(file);free(path);free(leaf);free(name);if(status)break;
+next:
+        step=ms_win_directory_next(&entries);
+    }
+    if(step<0)status=-1;
+    ms_win_directory_close(&entries);free(chain);return status;
+}
+static int scanfiles(char *target,char *base,int level,time_t now) {
+    wchar_t *input=ms_wide(target),*root;DWORD n,used;int code;
+    if(!input)return -1;n=GetFullPathNameW(input,0,NULL,NULL);
+    if(!n){free(input);return -1;}
+    root=malloc((size_t)n*sizeof(wchar_t));if(!root){free(input);return -1;}
+    used=GetFullPathNameW(input,n,root,NULL);free(input);
+    if(!used || used>=n){free(root);return -1;}
+    code=ms_scan_walk(root,base,level,0,now,NULL,0);free(root);return code;
+}
+/* Binary MSWIN1: explicit little-endian 64-bit fields, length-prefixed UTF-8
+ * filename, full volume/file ID. Legacy POSIX text is never reinterpreted. */
+static int ms_write64(FILE *fp,uint64_t value) {
+    unsigned char b[8];int i;for(i=0;i<8;++i){b[i]=(unsigned char)value;value>>=8;}return fwrite(b,1,8,fp)==8?0:-1;
+}
+static int ms_read64(FILE *fp,uint64_t *value) {
+    unsigned char b[8];size_t n=fread(b,1,8,fp);int i;
+    if(!n && feof(fp))return 0;if(n!=8)return -1;*value=0;for(i=7;i>=0;--i)*value=(*value<<8)|b[i];return 1;
+}
+static void printfilelist(FILE *fp) {
+    Stack *stack=StackCreate();RBNode *entry;RBBuildStack(filetree,stack);
+    while((entry=StackPop(stack))) {
+        FileKey *key=entry->key;FileNode *node=entry->data;int i;
+        fprintf(fp,"%s\t%016" PRIx64 "\t",key->filename,key->inode.volume);
+        for(i=0;i<16;++i)fprintf(fp,"%02x",key->inode.file[i]);
+        fprintf(fp,"\t%" PRId64 "\t%" PRId64 "\n",node->offset,(int64_t)node->modtime);
+    }
+    StackDestroy(stack,free);
+}
+static int savestate(char *path) {
+    FILE *fp=ms_native_fopen(path,"wb");Stack *stack;RBNode *entry;int error=0;uint64_t records=0;
+    if(!fp)return -1;
+    if(fwrite("MSWIN1\r\n",1,8,fp)!=8)error=1;
+    stack=StackCreate();RBBuildStack(filetree,stack);
+    while((entry=StackPop(stack))) {
+        FileKey *key=entry->key;FileNode *node=entry->data;size_t length=strlen(key->filename);
+        if(ms_write64(fp,length)<0 || fwrite(key->filename,1,length,fp)!=length || ms_write64(fp,key->inode.volume)<0
+          || fwrite(key->inode.file,1,16,fp)!=16 || ms_write64(fp,(uint64_t)node->offset)<0
+          || ms_write64(fp,(uint64_t)(int64_t)node->modtime)<0)error=1;
+        ++records;
+    }
+    if(ms_write64(fp,UINT64_MAX)<0 || ms_write64(fp,records)<0)error=1;
+    StackDestroy(stack,free);if(fclose(fp))error=1;
+    if(error)lprintf(0,"Windows state write failed: %s",path);return error?-1:0;
+}
+static int recoverstate(char *path) {
+    FILE *fp=ms_native_fopen(path,"rb");char magic[8];int status,error=0,footer=0;uint64_t length,records=0;
+    if(!fp)return -1;
+    if(fread(magic,1,8,fp)!=8 || memcmp(magic,"MSWIN1\r\n",8)){error=1;goto done;}
+    while((status=ms_read64(fp,&length))==1) {
+        char *name;ms_win_identity id;uint64_t offset,modified;FileNode *node;
+        if(length==UINT64_MAX){uint64_t expected;footer=1;if(ms_read64(fp,&expected)!=1 || expected!=records || fgetc(fp)!=EOF)error=1;break;}
+        if(!length || length>SIZE_MAX-sizeof(FileKey)-1){error=1;break;}
+        name=malloc((size_t)length+1);if(!name){error=1;break;}
+        if(fread(name,1,(size_t)length,fp)!=length || memchr(name,0,(size_t)length)
+           || ms_read64(fp,&id.volume)!=1 || fread(id.file,1,16,fp)!=16
+           || ms_read64(fp,&offset)!=1 || ms_read64(fp,&modified)!=1){free(name);error=1;break;}
+        name[length]=0;
+        {wchar_t *validated=ms_wide(name);if(!validated){free(name);error=1;break;}free(validated);}
+        if(offset>INT64_MAX && offset!=UINT64_MAX){free(name);error=1;break;}
+        {FileKey *key=malloc(sizeof(FileKey)+(size_t)length);if(!key){free(name);error=1;break;}
+         key->inode=id;strcpy(key->filename,name);if(findfile(key)){free(key);free(name);error=1;break;}free(key);}
+        node=addfile(id,name,(time_t)(int64_t)modified);free(name);
+        if(!node){error=1;break;}node->offset=(int64_t)offset;node->scantime=0;
+        ++records;
+    }
+    if(!footer || status<0 || ferror(fp))error=1;
+done:
+    fclose(fp);
+    if(error){errno=EINVAL;lprintf(0,"Malformed/incompatible Windows state; explicit reset/migration required: %s",path);return -1;}
+    return 0;
+}
