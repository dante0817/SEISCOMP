--- /dev/null
+++ b/phase8/native-working-copy/src/base/seedlink/plugins/scream2_plugin/windows_ring_private.c
@@ -0,0 +1,58 @@
+#include "windows_ring_private.h"
+#include <process.h>
+#include <stdio.h>
+#include <stdlib.h>
+static HANDLE workers[2];
+static unsigned worker_count;
+static int winsock_owned;
+static volatile LONG control_flags;
+static BOOL WINAPI control(DWORD code){
+ if(code==CTRL_BREAK_EVENT){InterlockedOr(&control_flags,2);return TRUE;}
+ if(code==CTRL_C_EVENT || code==CTRL_CLOSE_EVENT || code==CTRL_SHUTDOWN_EVENT || code==CTRL_LOGOFF_EVENT){InterlockedOr(&control_flags,1);return TRUE;}
+ return FALSE;
+}
+/* Preserve original process-exit lifetime. Close owned thread handles and the
+ * process Winsock reference; this is not a new joined/graceful shutdown policy. */
+static void cleanup(void){
+ unsigned i;for(i=0;i<worker_count;++i)if(workers[i]){CloseHandle(workers[i]);workers[i]=NULL;}
+ if(winsock_owned){WSACleanup();winsock_owned=0;}
+}
+int ring_startup(void){
+ WSADATA data;int error=WSAStartup(MAKEWORD(2,2),&data);
+ if(error){fprintf(stderr,"WSAStartup failed: %d\n",error);return -1;}
+ winsock_owned=1;
+ if(data.wVersion!=MAKEWORD(2,2) || atexit(cleanup)!=0){cleanup();return -1;}
+ if(!SetConsoleCtrlHandler(control,TRUE)){cleanup();return -1;}
+ return 0;
+}
+struct worker_arg{void *(*function)(void*);void *argument;};
+static unsigned __stdcall worker(void *p){struct worker_arg copy=*(struct worker_arg*)p;free(p);copy.function(copy.argument);return 0;}
+int ring_start_worker(ring_worker_t *out,void *(*function)(void*),void *argument){
+ struct worker_arg *p;uintptr_t h;
+ if(worker_count>=2)return -1;
+ p=(struct worker_arg*)malloc(sizeof(*p));if(!p)return -1;
+ p->function=function;p->argument=argument;h=_beginthreadex(NULL,0,worker,p,0,NULL);
+ if(!h){free(p);return -1;}
+ *out=(HANDLE)h;workers[worker_count++]=*out;return 0;
+}
+int ring_lock_try(ring_lock_t *lock){return TryAcquireSRWLockExclusive(lock)?0:1;}
+void ring_unlock(ring_lock_t *lock){ReleaseSRWLockExclusive(lock);}
+void ring_sleep_seconds(unsigned int seconds){Sleep(seconds*1000u);}
+void ring_sleep_us(unsigned long microseconds){
+ HANDLE timer;LARGE_INTEGER due;
+ if(!microseconds){SwitchToThread();return;}
+ timer=CreateWaitableTimerW(NULL,FALSE,NULL);
+ if(!timer){fprintf(stderr,"CreateWaitableTimer failed: %lu\n",GetLastError());exit(1);}
+ due.QuadPart=-((LONGLONG)microseconds*10);
+ if(!SetWaitableTimer(timer,&due,0,NULL,NULL,FALSE) || WaitForSingleObject(timer,INFINITE)!=WAIT_OBJECT_0){
+  DWORD error=GetLastError();CloseHandle(timer);fprintf(stderr,"waitable sleep failed: %lu\n",error);exit(1);
+ }
+ CloseHandle(timer);
+}
+int ring_poll_control(void){return (int)InterlockedExchange(&control_flags,0);}
+double ring_wall_time(void){FILETIME time;ULARGE_INTEGER value;GetSystemTimeAsFileTime(&time);value.LowPart=time.dwLowDateTime;value.HighPart=time.dwHighDateTime;return (double)value.QuadPart/10000000.0-11644473600.0;}
+int ring_recv(ring_socket_t socket,char *buffer,int length){
+ int n=recv(socket,buffer,length,0);
+ if(n==SOCKET_ERROR && WSAGetLastError()==WSAEMSGSIZE)return length;
+ return n;
+}
