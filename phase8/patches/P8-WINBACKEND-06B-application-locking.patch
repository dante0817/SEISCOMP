+/* Windows-only private application ownership adapter. Not an installed API.
+ * See application.cpp for SeisComP licensing and upstream provenance. */
+#ifndef SEISCOMP_SYSTEM_WINDOWS_LOCK_H
+#define SEISCOMP_SYSTEM_WINDOWS_LOCK_H
+#include <string>
+namespace Seiscomp { namespace System { namespace Detail {
+int acquireWindowsApplicationLock(const void *owner, const std::string &path);
+void releaseWindowsApplicationLocks(const void *owner);
+}}}
+#endif
