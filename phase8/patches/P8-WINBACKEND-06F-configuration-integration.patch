diff --git a/src/system/apps/seiscomp/seiscomp-control.py b/src/system/apps/seiscomp/seiscomp-control.py
--- a/src/system/apps/seiscomp/seiscomp-control.py
+++ b/src/system/apps/seiscomp/seiscomp-control.py
@@ -362,8 +362,24 @@
 # ------------------------------------------------------------------------------
 def on_setup(args, flags):
     if os.name == "nt":
-        error("Windows setup requires reviewed module configuration adapters; no changes made")
-        return 1
+        # Only this original handler has a reviewed filesystem-only write path.
+        # Interactive kernel setup lacks a matching setup schema; require stdin.
+        if args != ["kernel"] or set(flags) != {"stdin"}:
+            error("Windows setup supports only explicit '--stdin setup kernel'; other handlers require configuration/DB/service adapters")
+            return 1
+        selected = [mod for mod in config_mods if mod.name == "kernel"]
+        if len(selected) != 1:
+            error("Exactly one kernel configuration handler is required")
+            return 1
+        cfg = seiscomp.config.Config()
+        if not cfg.readConfig("-"):
+            error("invalid configuration from stdin")
+            return 1
+        try:
+            return 0 if selected[0].setup(cfg) == 0 else 1
+        except Exception as exc:
+            error(f"Kernel configuration setup failed: {exc}")
+            return 1
     # pylint: disable=C0415,W0621
     import seiscomp.setup
 
