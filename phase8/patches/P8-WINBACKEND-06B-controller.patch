diff --git a/src/system/libs/python/seiscomp/windows.py b/src/system/libs/python/seiscomp/windows.py
new file mode 100644
--- /dev/null
+++ b/src/system/libs/python/seiscomp/windows.py
@@ -0,0 +1,567 @@
+############################################################################
+# Windows controller portability adapter. See kernel.py for SeisComP license.
+# Private launch/ownership bookkeeping; no remote control or signal protocol.
+############################################################################
+import contextlib
+import ctypes as C
+from ctypes import wintypes as W
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+if os.name != "nt":
+    raise ImportError("seiscomp.windows is Windows-only")
+
+K = C.WinDLL("kernel32", use_last_error=True)
+S = C.WinDLL("shell32", use_last_error=True)
+HANDLE, DWORD, SIZE = W.HANDLE, W.DWORD, C.c_size_t
+INVALID = C.c_void_p(-1).value
+WAIT_TIMEOUT = 258
+
+
+class ControlProtocolRequired(RuntimeError):
+    pass
+
+
+class Overlapped(C.Structure):
+    _fields_ = [("internal", SIZE), ("internal_high", SIZE),
+                ("offset", DWORD), ("offset_high", DWORD), ("event", HANDLE)]
+
+
+class FileInfo(C.Structure):
+    _fields_ = [("attributes", DWORD), ("created", W.FILETIME),
+                ("accessed", W.FILETIME), ("written", W.FILETIME),
+                ("volume", DWORD), ("size_high", DWORD), ("size_low", DWORD),
+                ("links", DWORD), ("index_high", DWORD), ("index_low", DWORD)]
+
+
+class StartupInfo(C.Structure):
+    _fields_ = [("cb", DWORD), ("reserved", W.LPWSTR), ("desktop", W.LPWSTR),
+                ("title", W.LPWSTR)] + [(name, DWORD) for name in
+                ("x", "y", "xsize", "ysize", "xchars", "ychars", "fill", "flags")] + [
+                ("show", W.WORD), ("reserved_size", W.WORD), ("reserved_data", C.c_void_p),
+                ("stdin", HANDLE), ("stdout", HANDLE), ("stderr", HANDLE)]
+
+
+class StartupInfoEx(C.Structure):
+    _fields_ = [("startup", StartupInfo), ("attributes", C.c_void_p)]
+
+
+class ProcessInfo(C.Structure):
+    _fields_ = [("process", HANDLE), ("thread", HANDLE), ("pid", DWORD), ("tid", DWORD)]
+
+
+class JobBasic(C.Structure):
+    _fields_ = [("process_time", C.c_longlong), ("job_time", C.c_longlong),
+                ("flags", DWORD), ("min_working_set", SIZE), ("max_working_set", SIZE),
+                ("active_process_limit", DWORD), ("affinity", SIZE),
+                ("priority", DWORD), ("scheduling", DWORD)]
+
+
+class IoCounters(C.Structure):
+    _fields_ = [(name, C.c_ulonglong) for name in
+                ("read_operations", "write_operations", "other_operations",
+                 "read_bytes", "write_bytes", "other_bytes")]
+
+
+class JobLimits(C.Structure):
+    _fields_ = [("basic", JobBasic), ("io", IoCounters),
+                ("process_memory", SIZE), ("job_memory", SIZE),
+                ("peak_process_memory", SIZE), ("peak_job_memory", SIZE)]
+
+
+def api(name, result, args):
+    function = getattr(K, name)
+    function.restype, function.argtypes = result, args
+    return function
+
+
+create_file = api("CreateFileW", HANDLE, [W.LPCWSTR, DWORD, DWORD, C.c_void_p, DWORD, DWORD, HANDLE])
+close_handle = api("CloseHandle", W.BOOL, [HANDLE])
+lock_file = api("LockFileEx", W.BOOL, [HANDLE, DWORD, DWORD, DWORD, DWORD, C.POINTER(Overlapped)])
+unlock_file = api("UnlockFileEx", W.BOOL, [HANDLE, DWORD, DWORD, DWORD, C.POINTER(Overlapped)])
+file_info = api("GetFileInformationByHandle", W.BOOL, [HANDLE, C.POINTER(FileInfo)])
+seek_file = api("SetFilePointerEx", W.BOOL, [HANDLE, C.c_longlong, C.c_void_p, DWORD])
+read_file = api("ReadFile", W.BOOL, [HANDLE, C.c_void_p, DWORD, C.POINTER(DWORD), C.c_void_p])
+write_file = api("WriteFile", W.BOOL, [HANDLE, C.c_void_p, DWORD, C.POINTER(DWORD), C.c_void_p])
+truncate_file = api("SetEndOfFile", W.BOOL, [HANDLE])
+get_times = api("GetProcessTimes", W.BOOL, [HANDLE] + [C.POINTER(W.FILETIME)] * 4)
+image_name = api("QueryFullProcessImageNameW", W.BOOL, [HANDLE, DWORD, W.LPWSTR, C.POINTER(DWORD)])
+open_process = api("OpenProcess", HANDLE, [DWORD, W.BOOL, DWORD])
+wait_process = api("WaitForSingleObject", DWORD, [HANDLE, DWORD])
+exit_code = api("GetExitCodeProcess", W.BOOL, [HANDLE, C.POINTER(DWORD)])
+terminate_process = api("TerminateProcess", W.BOOL, [HANDLE, W.UINT])
+resume_thread = api("ResumeThread", DWORD, [HANDLE])
+current_process = api("GetCurrentProcess", HANDLE, [])
+std_handle = api("GetStdHandle", HANDLE, [DWORD])
+duplicate = api("DuplicateHandle", W.BOOL, [HANDLE, HANDLE, HANDLE, C.POINTER(HANDLE), DWORD, W.BOOL, DWORD])
+init_attributes = api("InitializeProcThreadAttributeList", W.BOOL, [C.c_void_p, DWORD, DWORD, C.POINTER(SIZE)])
+update_attributes = api("UpdateProcThreadAttribute", W.BOOL, [C.c_void_p, DWORD, SIZE, C.c_void_p, SIZE, C.c_void_p, C.c_void_p])
+delete_attributes = api("DeleteProcThreadAttributeList", None, [C.c_void_p])
+create_process = api("CreateProcessW", W.BOOL, [W.LPCWSTR, W.LPWSTR, C.c_void_p, C.c_void_p,
+    W.BOOL, DWORD, C.c_void_p, W.LPCWSTR, C.c_void_p, C.POINTER(ProcessInfo)])
+create_job = api("CreateJobObjectW", HANDLE, [C.c_void_p, W.LPCWSTR])
+set_job = api("SetInformationJobObject", W.BOOL, [HANDLE, C.c_int, C.c_void_p, DWORD])
+S.CommandLineToArgvW.restype = C.POINTER(W.LPWSTR)
+S.CommandLineToArgvW.argtypes = [W.LPCWSTR, C.POINTER(C.c_int)]
+local_free = api("LocalFree", HANDLE, [HANDLE])
+
+
+def checked(result):
+    if not result:
+        raise C.WinError(C.get_last_error())
+    return result
+
+
+def canonical(path):
+    return os.path.normcase(os.path.realpath(os.path.abspath(path)))
+
+
+class FileLock:
+    def __init__(self, path, create=False):
+        self.handle = create_file(os.fspath(path), 0xC0000000, 3, None, 4 if create else 3, 0x80, None)
+        if self.handle == INVALID:
+            self.handle = None
+            raise C.WinError(C.get_last_error())
+        self.owned = False
+        self.position = Overlapped()
+        self.position.offset, self.position.offset_high = 0xFFFFFFFE, 0x7FFFFFFF
+
+    def acquire(self):
+        if self.owned:
+            return True
+        if lock_file(self.handle, 3, 0, 1, 0, C.byref(self.position)):
+            self.owned = True
+            return True
+        error = C.get_last_error()
+        if error == 33:  # ERROR_LOCK_VIOLATION; never treat access denied as unlocked.
+            return False
+        raise C.WinError(error)
+
+    def identity(self):
+        information = FileInfo()
+        checked(file_info(self.handle, C.byref(information)))
+        if information.attributes & 0x10 or not (information.index_high or information.index_low):
+            raise RuntimeError("Lockfile has no usable native file identity")
+        return [information.volume, information.index_high, information.index_low]
+
+    def pid(self):
+        checked(seek_file(self.handle, 0, None, 0))
+        buffer, count = C.create_string_buffer(64), DWORD()
+        checked(read_file(self.handle, buffer, 64, C.byref(count), None))
+        lines = buffer.raw[:count.value].decode("ascii").splitlines()
+        if not lines or not lines[0].isdigit() or not 0 < int(lines[0]) <= 0xFFFFFFFF:
+            raise ValueError("Invalid lockfile PID metadata")
+        return int(lines[0])
+
+    def write_pid(self):
+        if not self.owned:
+            raise RuntimeError("PID metadata requires exclusive ownership")
+        data, written = str(os.getpid()).encode("ascii") + b"\n", DWORD()
+        buffer = C.create_string_buffer(data)
+        checked(seek_file(self.handle, 0, None, 0))
+        checked(truncate_file(self.handle))
+        checked(write_file(self.handle, buffer, len(data), C.byref(written), None))
+        if written.value != len(data):
+            raise OSError("Incomplete PID metadata write")
+
+    def close(self):
+        if self.handle:
+            if self.owned:
+                unlock_file(self.handle, 0, 1, 0, C.byref(self.position))
+            close_handle(self.handle)
+            self.handle, self.owned = None, False
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *args):
+        self.close()
+
+
+def optional_lock(path):
+    try:
+        return FileLock(path)
+    except OSError as error:
+        if error.winerror in (2, 3):
+            return None
+        raise
+
+
+def lock_available(path, timeout=None):
+    # Preserve explicit waitlock(0) = no deadline; immediate probe for None.
+    if timeout is not None and timeout < 0:
+        raise ValueError("Lock timeout must not be negative")
+    deadline = None if timeout in (None, 0) else time.monotonic() + timeout
+    while True:
+        lock = optional_lock(path)
+        if lock is None:
+            return True
+        with lock:
+            if lock.acquire():
+                return True
+        if timeout is None or (deadline is not None and time.monotonic() >= deadline):
+            return False
+        time.sleep(0.05)
+
+
+def process_identity(handle):
+    created, ended, kernel, user = (W.FILETIME() for _ in range(4))
+    checked(get_times(handle, C.byref(created), C.byref(ended), C.byref(kernel), C.byref(user)))
+    image, size = C.create_unicode_buffer(32768), DWORD(32768)
+    checked(image_name(handle, 0, image, C.byref(size)))
+    return {"created": (created.dwHighDateTime << 32) | created.dwLowDateTime,
+            "image": canonical(image.value)}
+
+
+class Process:
+    def __init__(self, handle, pid, thread=None, may_terminate=False, job=None):
+        self.handle, self.thread, self.pid = handle, thread, pid
+        self.may_terminate = may_terminate
+        self.job = job
+
+    def handoff(self):
+        # Only commit an intended detached launch after its ownership record exists.
+        # Until then, controller death closes this noninherited kill-on-close job.
+        if self.job:
+            limits = JobLimits()
+            checked(set_job(self.job, 9, C.byref(limits), C.sizeof(limits)))
+            checked(close_handle(self.job))
+            self.job = None
+
+    def poll(self):
+        result = wait_process(self.handle, 0)
+        if result == WAIT_TIMEOUT:
+            return None
+        if result != 0:
+            raise C.WinError(C.get_last_error())
+        code = DWORD()
+        checked(exit_code(self.handle, C.byref(code)))
+        return code.value
+
+    def wait(self, seconds):
+        if seconds < 0:
+            raise ValueError("Negative process timeout")
+        end = time.monotonic() + seconds
+        while True:
+            code = self.poll()
+            if code is not None:
+                return code
+            remaining = end - time.monotonic()
+            if remaining <= 0:
+                return None
+            result = wait_process(self.handle, min(100, max(1, int(remaining * 1000))))
+            if result not in (0, WAIT_TIMEOUT):
+                raise C.WinError(C.get_last_error())
+
+    def resume(self):
+        result = resume_thread(self.thread)
+        if result == 0xFFFFFFFF:
+            raise C.WinError(C.get_last_error())
+        close_handle(self.thread)
+        self.thread = None
+
+    def abort_launch(self):
+        # This handle comes from our own successful CreateProcessW, never a PID lookup.
+        if not self.may_terminate:
+            raise RuntimeError("Process is not owned by this launcher")
+        if self.poll() is None:
+            if not terminate_process(self.handle, 1) and self.poll() is None:
+                raise C.WinError(C.get_last_error())
+            if self.wait(5) is None:
+                raise TimeoutError("Owned child did not finish termination in five seconds")
+
+    def close(self):
+        if self.job:
+            close_handle(self.job)
+            self.job = None
+        if self.thread:
+            close_handle(self.thread)
+            self.thread = None
+        if self.handle:
+            close_handle(self.handle)
+            self.handle = None
+
+
+def spawn(argv, cwd, environment, streams=None, background=False):
+    """CreateProcessW with explicit executable, environment, cwd and handle allowlist."""
+    import msvcrt
+    argv = [os.fspath(value) for value in argv]
+    if not argv or any("\0" in value for value in argv):
+        raise ValueError("Invalid native argv")
+    image = argv[0] if os.path.isabs(argv[0]) else shutil.which(argv[0], path=environment.get("PATH"))
+    if not image or not image.lower().endswith(".exe"):
+        raise FileNotFoundError("CreateProcessW requires a native executable or explicit interpreter")
+    argv[0] = os.path.abspath(image)
+    command = subprocess.list2cmdline(argv)
+    if len(command) >= 32767:
+        raise ValueError("Windows command line exceeds CreateProcessW limit")
+    values = {}
+    for key, value in environment.items():
+        if "\0" in key or "\0" in value or "=" in key:
+            raise ValueError("Invalid Windows environment entry")
+        values[key.upper()] = (key, value)
+    block = "\0".join("%s=%s" % values[key] for key in sorted(values)) + "\0\0"
+    env_buffer, cmd_buffer = C.create_unicode_buffer(block), C.create_unicode_buffer(command)
+    handles, attribute_buffer, attributes_ready, job = [], None, False, None
+    with contextlib.ExitStack() as stack:
+        try:
+            raw = list(streams) if streams is not None else [std_handle(n & 0xFFFFFFFF) for n in (-10, -11, -12)]
+            inherited = []
+            for index, source in enumerate(raw):
+                if source in (None, 0, INVALID):
+                    file = stack.enter_context(open(os.devnull, "rb" if index == 0 else "wb"))
+                    source = msvcrt.get_osfhandle(file.fileno())
+                target = HANDLE()
+                checked(duplicate(current_process(), source, current_process(), C.byref(target), 0, True, 2))
+                handles.append(target.value)
+                inherited.append(target.value)
+            size = SIZE()
+            init_attributes(None, 2, 0, C.byref(size))
+            if not size.value:
+                raise C.WinError(C.get_last_error())
+            attribute_buffer = C.create_string_buffer(size.value)
+            checked(init_attributes(attribute_buffer, 2, 0, C.byref(size)))
+            attributes_ready = True
+            allowlist = (HANDLE * len(handles))(*handles)
+            checked(update_attributes(attribute_buffer, 0, 0x20002, allowlist,
+                                      C.sizeof(allowlist), None, None))
+            job = checked(create_job(None, None))
+            limits = JobLimits()
+            limits.basic.flags = 0x2000  # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+            checked(set_job(job, 9, C.byref(limits), C.sizeof(limits)))
+            jobs = (HANDLE * 1)(job)
+            # PROC_THREAD_ATTRIBUTE_JOB_LIST (Windows 10+): atomic assignment at
+            # creation avoids an orphan window between CreateProcess and AssignJob.
+            # Unsupported hosts or restrictive outer jobs fail without launching.
+            checked(update_attributes(attribute_buffer, 0, 0x2000D, jobs,
+                                      C.sizeof(jobs), None, None))
+            startup, information = StartupInfoEx(), ProcessInfo()
+            startup.startup.cb = C.sizeof(startup)
+            startup.startup.flags = 0x100 | 1  # USESTDHANDLES | USESHOWWINDOW
+            startup.startup.show = 0  # SW_HIDE
+            startup.startup.stdin, startup.startup.stdout, startup.startup.stderr = inherited
+            startup.attributes = C.cast(attribute_buffer, C.c_void_p)
+            flags = 0x400 | 0x80000 | 4  # UNICODE_ENVIRONMENT | EXTENDED_STARTUPINFO | SUSPENDED
+            if background:
+                flags |= 0x08000000  # CREATE_NO_WINDOW; no fake Unix daemon/fork.
+            checked(create_process(argv[0], cmd_buffer, None, None, True, flags,
+                                   env_buffer, cwd, C.byref(startup), C.byref(information)))
+            process = Process(information.process, information.pid, information.thread,
+                              may_terminate=True, job=job)
+            job = None
+            return process
+        finally:
+            if job:
+                close_handle(job)
+            if attributes_ready:
+                delete_attributes(attribute_buffer)
+            for handle in handles:
+                close_handle(handle)
+
+
+def parameters(text):
+    if not isinstance(text, str):
+        return list(text)
+    count = C.c_int()
+    result = S.CommandLineToArgvW("seiscomp-params " + text, C.byref(count))
+    checked(result)
+    try:
+        return [result[index] for index in range(1, count.value)]
+    finally:
+        local_free(C.cast(result, HANDLE))
+
+
+def interpreter_command(argv):
+    argv = list(argv)
