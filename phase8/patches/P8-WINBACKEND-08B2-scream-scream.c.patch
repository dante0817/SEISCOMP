 #include "project.h"
 
+#ifdef _WIN32
+/* A SOCKET is pointer-width and must never pass through the CRT descriptor API. */
+#include <ws2tcpip.h>
+static SOCKET sockfd = INVALID_SOCKET;
+static int winsock_ready;
+
+static void scm_windows_cleanup(void)
+{
+  if (sockfd != INVALID_SOCKET) {
+    closesocket(sockfd);
+    sockfd = INVALID_SOCKET;
+  }
+  if (winsock_ready) {
+    WSACleanup();
+    winsock_ready = 0;
+  }
+}
+
+static void scm_windows_error(const char *operation, int error, int fatal_error)
+{
+  fprintf(stderr, "SCREAM %s: Winsock error %d\n", operation, error);
+  if (fatal_error) exit(-1);
+}
+
+static void scm_windows_start(void)
+{
+  WSADATA data;
+  int error;
+  if (winsock_ready) return;
+  error = WSAStartup(MAKEWORD(2, 2), &data);
+  if (error) scm_windows_error("WSAStartup", error, 1);
+  if (LOBYTE(data.wVersion) != 2 || HIBYTE(data.wVersion) != 2) {
+    WSACleanup();
+    scm_windows_error("WSAStartup version", WSAVERNOTSUPPORTED, 1);
+  }
+  winsock_ready = 1;
+  if (atexit(scm_windows_cleanup) != 0) {
+    scm_windows_cleanup();
+    fprintf(stderr, "SCREAM cannot register owned Winsock cleanup\n");
+    exit(-1);
+  }
+}
